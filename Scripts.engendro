 Trunk&#xD;&#xA;{&#xD;&#xA;&#x9;if Verb == LookAt&#xD;&#xA;&#x9;&#x9;echo &quot;Un viejo baúl de madera astillada. Tiene un cerrojo tosco de hierro.&quot;&#xD;&#xA;&#x9;else&#xD;&#xA;&#xD;&#xA;&#x9;&#x9;if-can-pickup-item-reward this&#xD;&#xA;&#x9;&#x9;&#x9;animate-actor $Player RaiseArm #preserve await&#xD;&#xA;&#x9;&#x9;&#x9;pickup-item-reward this&#xD;&#xA;&#x9;&#x9;&#x9;animate-actor $Player RaiseArm #reverse await&#x9;&#x9;&#x9;&#xD;&#xA;&#x9;&#x9;endif&#x9;&#x9;&#xD;&#xA;&#x9;endif&#xD;&#xA;}&#xD;&#xA;&#xD;&#xA;Outcome Trunk+CrudeKey&#xD;&#xA;{&#xD;&#xA;&#x9;if IsOpen == false&#xD;&#xA;&#x9;&#x9;animate-actor $Player PickUp&#xD;&#xA;&#x9;&#x9;await-animation-trigger $Player&#xD;&#xA;&#x9;&#x9;play-sound TrunkOpen #emitter:this&#xD;&#xA;&#x9;&#x9;=&gt; IsOpen = true&#xD;&#xA;&#x9;&#x9;apply-usage CrudeKey&#xD;&#xA;&#x9;&#x9;reload this&#xD;&#xA;&#x9;&#x9;return&#xD;&#xA;&#x9;endif&#xD;&#xA;}" /><Folder Name="Cross"><Script IsDocumentOpen="true" CaretOffset="184" SourceCode="Thing CrossA Class:Prop Cloneable&#xD;&#xA;{&#xD;&#xA;&#x9;=&gt; Atlas = Props&#xD;&#xA;&#x9;=&gt; Collider = 14,15;15,18;0,18;1,15&#xD;&#xA;&#x9;=&gt; DeathSound = WoodDebris&#xD;&#xA;&#x9;=&gt; DepthOffset = -3&#xD;&#xA;&#x9;=&gt; Hotspot = 5,1;10,6;9,18;5,18;1,6&#xD;&#xA;&#x9;=&gt; LabelKey = &quot;Prop.Cross&quot;&#xD;&#xA;&#x9;=&gt; ShadowOffset = 3,-1&#xD;&#xA;&#x9;=&gt; Verb = LookAt&#xD;&#xA;}&#xD;&#xA;&#xD;&#xA;Outcome CrossA&#xD;&#xA;{&#xD;&#xA;&#x9;echo &quot;Una cruz de madera.&quot;&#xD;&#xA;}&#x9;" /><Script IsDocumentOpen="true" CaretOffset="118" SourceCode="Thing CrossB Class:Prop Cloneable&#xD;&#xA;{&#xD;&#xA;&#x9;=&gt; Atlas = Props&#xD;&#xA;&#x9;=&gt; Collider = 14,10;18,16;-2,16;2,10&#xD;&#xA;&#x9;=&gt; DepthOffset = -3&#xD;&#xA;}" /><Script IsDocumentOpen="true" CaretOffset="118" SourceCode="Thing CrossC Class:Prop Cloneable&#xD;&#xA;{&#xD;&#xA;&#x9;=&gt; Atlas = Props&#xD;&#xA;&#x9;=&gt; Collider = 13,15;14,18;-1,18;0,15&#xD;&#xA;&#x9;=&gt; DepthOffset = -3&#xD;&#xA;}" 