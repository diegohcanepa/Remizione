ing CineraryUrn Class:CineraryUrn Cloneable&#xD;&#xA;{&#xD;&#xA;&#x9;=&gt; AshCost = 50&#xD;&#xA;&#x9;=&gt; DepthOffset = -2&#xD;&#xA;}&#xD;&#xA;&#xD;&#xA;Outcome CineraryUrn&#xD;&#xA;{&#xD;&#xA;&#x9;//if IsEnabled == false&#xD;&#xA;//&#x9;&#x9;echo &quot;Las urnas cinerarias se abren durante el ciclo de oscuridad.&quot;&#xD;&#xA;///&#x9;&#x9;return&#xD;&#xA;//&#x9;endif&#xD;&#xA;&#xD;&#xA;&#x9;create-dialog-block&#xD;&#xA;&#x9;&#xD;&#xA;&#x9;add-dialog-option 1 &quot;Ofrendar cenizas&quot;&#xD;&#xA;&#x9;add-dialog-option 2 &quot;No hacer nada&quot;&#xD;&#xA;&#x9;&#xD;&#xA;&#x9;await-dialog-block&#xD;&#xA;&#x9;&#xD;&#xA;&#x9;if $DialogOptionId == 1&#xD;&#xA;&#x9;&#x9;if-can-use-ashes this&#xD;&#xA;&#x9;&#x9;&#x9;animate-actor $Player RestIn #preserve await&#xD;&#xA;&#x9;&#x9;&#x9;play-sound CineraryUrnUnlock&#xD;&#xA;&#x9;&#x9;&#x9;x-tween this Linear to .7 duration 40 #bounces:25 #relative await&#xD;&#xA;&#x9;&#x9;&#x9;=&gt;&gt; OfferAndShatter()&#xD;&#xA;&#x9;&#x9;&#x9;await 2000&#xD;&#xA;&#x9;&#x9;&#x9;animate-actor $Player RestOut await&#xD;&#xA;&#x9;&#x9;else&#xD;&#xA;&#x9;&#x9;&#x9;show-message NotEnoughAshes #bottom&#xD;&#xA;&#x9;&#x9;endif&#xD;&#xA;&#x9;&#x9;&#xD;&#xA;&#x9;endif&#xD;&#xA;}&#xD;&#xA;" /><Script IsDocumentOpen="true" CaretOffset="524" SourceCode="Thing Fleshiness Class:Fleshiness Cloneable&#xD;&#xA;{&#xD;&#xA;&#x9;=&gt; ApproachBehavior = Over&#xD;&#xA;}&#xD;&#xA;&#xD;&#xA;Outcome Fleshiness&#xD;&#xA;{&#xD;&#xA;&#x9;if-flag !threshold_fleshiness_comment_shown&#xD;&#xA;&#x9;&#x9;set-flag threshold_fleshiness_comment_shown to true&#xD;&#xA;&#x9;&#x9;echo &quot;Un charco de carnadura al pie de una tumba recién brotada de la tierra. Todo lo que queda de un penitente que pasó al olvido.&quot;&#xD;&#xA;&#x9;endif&#xD;&#xA;&#xD;&#xA;&#x9;create-dialog-block&#xD;&#xA;&#x9;&#xD;&#xA;&#x9;add-dialog-option 1 &quot;Hacerse carne&quot;&#xD;&#xA;&#x9;add-dialog-option 2 &quot;No hacer nada&quot;&#xD;&#xA;&#x9;&#xD;&#xA;&#x9;await-dialog-block&#xD;&#xA;&#x9;&#xD;&#xA;&#x9;if $DialogOptionId == 2&#xD;&#xA;&#x9;&#x9;return&#xD;&#xA;&#x9;endif&#xD;&#xA;&#xD;&#xA;&#x9;await 1000&#xD;&#xA;&#xD;&#xA;&#x9;set-flag threshold_fleshiness_present to false&#xD;&#xA;&#x9;&#xD;&#xA;&#x9;play-sound GravestoneRaise #emitter:$Player&#xD;&#xA;&#x9;animate-actor Penitent RestIn #preserve await&#xD;&#xA;&#x9;sepia-effect .5 #duration:3000&#xD;&#xA;&#x9;scale-tween $Player Linear to .5,0 duration 7500&#xD;&#xA;&#x9;opacity-tween $Player Linear to 0 duration 1500 await&#xD;&#xA;&#x9;&#xD;&#xA;&#x9;await 2500&#xD;&#xA;&#x9;&#xD;&#xA;&#x9;=&gt; $Player.Direction = Right&#xD;&#xA;&#x9;&#xD;&#xA;&#x9;play-sound Fleshiness #emitter:$Player&#xD;&#xA;&#x9;=&gt; $Player.Color = 255,255,255&#xD;&#xA;&#x9;scale-tween this Linear to 0,2 duration 1700&#x9;&#x9;&#xD;&#xA;&#x9;opacity-tween this Linear to 0 duration 2000&#xD;&#xA;&#x9;await 600&#xD;&#xA;&#x9;scale-tween $Player Linear to 1 duration 1500&#xD;&#xA;&#x9;opacity-tween $Player Linear to 1 duration 1500&#xD;&#xA;&#xD;&#xA;&#x9;await 2000&#xD;&#xA;&#xD;&#xA;&#x9;unparent this&#xD;&#xA;&#x9;x-tween $Player Linear to .15 duration 40 #bounces:-1 #relative&#xD;&#xA;&#xD;&#xA;&#x9;await 1000&#xD;&#xA;&#xD;&#xA;&#x9;put Monk into $Room #at:173,92 #opacity:0 #flip&#xD;&#xA;&#x9;&#xD;&#xA;&#x9;play-sound CycleDark&#xD;&#xA;&#x9;opacity-tween Monk Linear to 1 duration 2000 await&#xD;&#xA;&#x9;&#xD;&#xA;&#x9;play-music Main #looped&#xD;&#xA;&#x9;&#xD;&#xA;&#x9;await 1000&#xD;&#xA;&#x9;&#xD;&#xA;&#x9;say Monk &quot;Ahora sabes lo que duele respirar en esta tierra.&quot; #sound:Monk&#xD;&#xA;&#x9;say Monk &quot;Si la Redención existe para ti, hallarás el Santuario.&quot; #sound:Monk&#xD;&#xA;&#x9;say Monk &quot;Marcha y padece este suelo.&quot; #sound:Monk&#xD;&#xA;&#xD;&#xA;&#x9;=&gt; $Player.MaxHP = 5&#xD;&#xA;&#x9;=&gt; $DisplayHPMeter = true&#x9;&#xD;&#xA;&#x9;=&gt;&gt; $BeginCycles()&#xD;&#xA;&#xD;&#xA;&#x9;play-sound CycleDark&#xD;&#xA;&#x9;opacity-tween Monk Linear to 0 duration 2000 await&#xD;&#xA;&#x9;&#xD;&#xA;&#x9;await 1000&#xD;&#xA;&#xD;&#xA;&#x9;reset-tweens $Player&#xD;&#xA;&#x9;unparent Monk&#xD;&#xA;&#x9;&#xD;&#xA;&#x9;animate-actor $Player RestOut&#xD;&#xA;&#x9;&#xD;&#xA;&#x9;save-game&#xD;&#xA;}" /><Script IsDocumentOpen="true" CaretOffset="130" SourceCode="Thing GroundTorch Class:GroundTorch Cloneable Persistent&#xD;&#xA;{&#xD;&#xA;    =&gt; Collider = 8,24;1,24;2,21;7,21&#xD;&#xA;    =&gt; LabelKey = &quot;Prop.Torch&quot;&#xD;&#xA;    =&gt; Hotspot = 7,8;7,23;0,23;0,8&#xD;&#xA;    =&gt; OverheadOrigin = 3,3&#xD;&#xA;    =&gt; ShadowOffset = 0,-4&#xD;&#xA;&#x9;=&gt; StandPoint = 12,22    &#xD;&#xA;&#xD;&#xA;&#x9;animation Unlit&#xD;&#xA;&#x9;frame 1 duration 10000&#xD;&#xA;&#x9;&#xD;&#xA;&#x9;animation Lit&#xD;&#xA;&#x9;frame 2|5 duration 60&#xD;&#xA;}&#xD;&#xA;&#xD;&#xA;Load GroundTorch&#xD;&#xA;{&#xD;&#xA;&#x9;if IsLit == true&#xD;&#xA;&#x9;&#x9;=&gt; Verb = None&#xD;&#xA;&#x9;else&#xD;&#xA;&#x9;&#x9;=&gt; Verb = LookAt&#xD;&#xA;&#x9;endif&#xD;&#xA;}&#xD;&#xA;&#xD;&#xA;Outcome GroundTorch&#xD;&#xA;{&#xD;&#xA;&#x9;echo &quot;Una estructura rústica de madera. Su cúspide alberga un trozo de cobalto.&quot;&#xD;&#xA;}&#xD;&#xA;&#xD;&#xA;Outcome GroundTorch+SulfurStone&#xD;&#xA;{&#xD;&#xA;&#x9;if IsLit == true&#xD;&#xA;&#x9;&#x9;echo &quot;El faro ya esté encendido.&quot;&#xD;&#xA;&#x9;&#x9;return&#xD;&#xA;&#x9;endif&#xD;&#xA;&#x9;&#xD;&#xA;&#x9;animate-actor $Player RaiseArm #preserve await&#xD;&#xA;&#x9;apply-usage CobaltPebble&#xD;&#xA;&#x9;play-sound BonfireIgnition #emitter:this&#xD;&#xA;&#x9;=&gt; IsLit = true&#xD;&#xA;&#x9;animate-actor $Player RaiseArm #reverse await&#xD;&#xA;&#x9;reload this&#xD;&#xA;&#x9;=&gt;&gt; $ApplyAshCost()&#xD;&#xA;}" /><Script IsDocumentOpen="true" CaretOffset="47" SourceCode="Thing Orb Class:Orb Cloneable&#xD;&#xA;{&#xD;&#xA;}&#xD;&#xA;&#xD;&#xA;Outcome Orb&#xD;&#xA;{&#xD;&#xA;&#x9;if-can-pickup-item-reward this&#xD;&#xA;&#x9;&#x9;animate-actor $Player PickUp&#xD;&#xA;&#x9;&#x9;await-animation-trigger $Player&#xD;