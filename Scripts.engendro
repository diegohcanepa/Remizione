egado.&quot; Threshold_Intro2&#xD;&#xA;&#x9;//transition In #duration:4000 await&#xD;&#xA;&#x9;sepia-effect 1&#xD;&#xA;}&#xD;&#xA;&#xD;&#xA;Thing Intro-Image Class:Prop&#xD;&#xA;{&#xD;&#xA;&#x9;=&gt; PivotOrigin = Center&#xD;&#xA;&#x9;=&gt; Scale = .5&#xD;&#xA;&#x9;put this into Intro #at:120,85&#xD;&#xA;}" /></Folder><Folder Name="Threshold" IsExpanded="true"><Script IsDocumentOpen="true" CaretOffset="305" SourceCode="Room Threshold Class:ProceduralRoom Persistent&#xD;&#xA;{&#xD;&#xA;&#x9;add-walk-area Default polygon 475,82;473,243;412,254;375,245;240,245;204,252;180,242;81,249;8,248;8,18;43,16;102,23;144,22;146,32;163,37;202,42;213,35;205,28;218,19;241,14;260,14;275,10;288,11;319,27;356,26;378,47;404,54;438,81&#xD;&#xA;}&#xD;&#xA;&#xD;&#xA;Load Threshold&#xD;&#xA;{&#xD;&#xA;&#x9;if-flag threshold_fleshiness_present&#xD;&#xA;&#x9;&#x9;play-music Shadow #looped&#xD;&#xA;&#x9;else&#xD;&#xA;&#x9;&#x9;play-music Main #looped&#xD;&#xA;&#x9;endif&#xD;&#xA;&#x9;&#xD;&#xA;&#x9;if-flag !threshold_sack_taken&#xD;&#xA;&#x9;&#x9;put Sack into this #at:144,60&#xD;&#xA;&#x9;endif&#xD;&#xA;&#xD;&#xA;&#x9;if-flag threshold_hopeless_present&#xD;&#xA;&#x9;&#x9;put Hopeless into this&#xD;&#xA;&#x9;endif&#xD;&#xA;&#x9;&#xD;&#xA;&#x9;put CrossA into this #at:293,75&#xD;&#xA;&#x9;&#xD;&#xA;&#x9;put GravestoneA into this #at:142,90&#xD;&#xA;&#x9;&#xD;&#xA;&#x9;if-flag threshold_fleshiness_present&#xD;&#xA;&#x9;&#x9;put Fleshiness*Threshold into this #at:153,95&#xD;&#xA;&#x9;endif&#xD;&#xA;}&#xD;&#xA;&#xD;&#xA;Enter Threshold&#xD;&#xA;{&#xD;&#xA;&#x9;if-flag !threshold_intro_shown&#xD;&#xA;&#x9;&#x9;set-flag threshold_intro_shown to true&#xD;&#xA;&#x9;&#x9;start-routine Threshold-Intro await&#xD;&#xA;&#x9;endif&#xD;&#xA;}" /><Script IsDocumentOpen="true" CaretOffset="1190" SourceCode="Cloning Threshold&#xD;&#xA;{&#xD;&#xA;&#x9;clone CrossLargeA*Threshold #at:207,122 #parent:Threshold&#xD;&#xA;&#xD;&#xA;&#x9;clone Bonfire*Threshold*1 #at:260,158 #parent:Threshold #persistent&#xD;&#xA;&#x9;&#xD;&#xA;&#x9;clone Fleshiness*Threshold&#xD;&#xA;&#x9;&#xD;&#xA;&#x9;clone LargeRockA*Threshold #at:240,100 #parent:Threshold&#xD;&#xA;&#x9;clone LargeRockC*Threshold #at:114,78 #parent:Threshold&#xD;&#xA;&#x9;&#xD;&#xA;&#x9;clone PotteryA*Threshold #at:220,94 #parent:Threshold #persistent&#xD;&#xA;&#x9;&#xD;&#xA;&#x9;//clone GroundTorch*1*Threshold #at:115,82 #parent:Threshold #persistent&#xD;&#xA;&#x9;//clone GroundTorch*2*Threshold #at:77,125 #parent:Threshold #persistent&#xD;&#xA;&#x9;//clone GroundTorch*3*Threshold #at:285,100 #parent:Threshold #persistent&#xD;&#xA;&#x9;//clone GroundTorch*4*Threshold #at:345,134 #parent:Threshold #persistent&#xD;&#xA;&#xD;&#xA;&#x9;//=&gt; GroundTorch*1*Threshold.AshCost = 55&#xD;&#xA;&#x9;//=&gt; GroundTorch*2*Threshold.AshCost = 55&#xD;&#xA;&#x9;//=&gt; GroundTorch*3*Threshold.AshCost = 55&#xD;&#xA;&#x9;//=&gt; GroundTorch*4*Threshold.AshCost = 55&#xD;&#xA;&#xD;&#xA;&#x9;clone Trunk*Threshold #at:385,157 #parent:Threshold #persistent&#xD;&#xA;&#x9;=&gt; Trunk*Threshold.ItemRewardName = &quot;SulfurStone&quot;&#xD;&#xA;&#xD;&#xA;&#x9;//=&gt; GroundTorch*1*Threshold.IsLit = true&#xD;&#xA;&#x9;//=&gt; GroundTorch*3*Threshold.IsLit = true&#xD;&#xA;&#x9;&#xD;&#xA;&#x9;clone FigTree*Threshold #at:75,135 #parent:Threshold #persistent&#xD;&#xA;&#x9;&#xD;&#xA;&#x9;clone CineraryUrn*FigTree*Threshold #at:256,93 #parent:Threshold #persistent&#xD;&#xA;&#x9;=&gt; CineraryUrn*FigTree*Threshold.AshCost = 25&#xD;&#xA;&#x9;&#xD;&#xA;&#x9;clone CineraryUrn*Tower*Threshold #at:169,39 #parent:Threshold #persistent&#xD;&#xA;&#x9;=&gt; CineraryUrn*Tower*Threshold.AshCost = 70&#xD;&#xA;&#x9;=&gt; CineraryUrn*Tower*Threshold.Target = Threshold-Tower&#xD;&#xA;&#x9;&#xD;&#xA;&#x9;set-item-reward CineraryUrn*FigTree*Threshold AmberSap&#xD;&#xA;}&#x9;" /><Script IsSelected="true" IsDocumentOpen="true" CaretOffset="336" SourceCode="Thing Threshold-Tower Class:Prop&#xD;&#xA;{&#xD;&#xA;&#x9;=&gt; Hotspot = 196,0;192,39;161,34;164,0&#xD;&#xA;&#x9;=&gt; HotspotPlacement = Absolute&#xD;&#xA;&#x9;=&gt; LabelKey = &quot;Prop.Tunnel&quot;&#xD;&#xA;&#x9;=&gt; StandPoint = 170,37&#xD;&#xA;&#x9;&#xD;&#xA;&#x9;put this into Threshold&#xD;&#xA;}&#xD;&#xA;&#xD;&#xA;Load Threshold-Tower&#xD;&#xA;{&#xD;&#xA;&#x9;if CineraryUrn*Tower*Threshold.IsInCurrentRoom == true&#xD;&#xA;&#x9;&#x9;=&gt; Verb = None&#xD;&#xA;&#x9;else&#xD;&#xA;&#x9;&#x9;=&gt; Verb = GoUp&#xD;&#xA;&#x9;endif&#xD;&#xA;}&#xD;&#xA;&#xD;&#xA;Outcome Threshold-Tower&#xD;&#xA;{&#xD;&#xA;&#x9;if Verb == LookAt&#xD;&#xA;&#x9;&#x9;echo &quot;La entrada de un túnel. Una urna cineraria está bloqueando el paso.&quot;&#xD;&#xA;&#x9;endif&#xD;&#xA;}" /><Folder Name="Routines" IsExpanded="true"><Script IsDocumentOpen="true" CaretOffset="989" SourceCode="Routine Threshold-Intro&#xD;&#xA;{&#xD;&#xA;&#x9;//transition In #immediate&#xD;&#xA;&#x9;//zoom %DefaultZoom&#xD;&#xA;&#x9;//focus Hopeless&#xD;&#xA;&#x9;//transition Out #duration:4000 await&#xD;&#xA;&#xD;&#xA;&#x9;//await 1000&#xD;&#xA;&#xD;&#xA;&#x9;//say Hopeless &quot;¡Maldita sea esta carne!&quot; #sound:SpeakerMale&#xD;&#xA;&#x9;&#xD;&#xA;&#x9;//play-sound HopelessVanish #emitter:Hopeless&#xD;&#xA;&#x9;//color-tween Hopeless CubicIn to 0,0,0 duration 800&#xD;&#xA;&#x9;//play-sound HopelessDeath #emitter:Hopeless&#xD;&#xA;&#x9;//animate-actor Hopeless Vanish #preserve await&#xD;&#xA;&#x9;//put Fleshiness*Threshold into Threshold #at:128,70 #opacity:0&#xD;&#xA;&#x9;//opacity-tween Hopeless CubicIn to 0 duration 1800 await&#xD;&#xA;&#x9;//put GravestoneA into $Room #at:126,72&#xD;&#xA;&#x9;//start-routine GravestoneA-Raise await&#xD;&#xA;&#x9;&#xD;&#xA;&#x9;&#xD;&#xA;&#x9;//opacity-tween Fleshiness*Threshold CubicIn to 1 duration 2100&#xD;&#xA;&#xD;&#xA;&#x9;//await 1000&#xD;&#xA;&#x9;&#xD;&#xA;&#x9;set-flag threshold_hopeless_present to false&#xD;&#xA;&#xD;&#xA;&#x9;//await 1000&#xD;&#xA;&#xD;&#xA;&#x9;=&gt; $Player = Penitent&#xD;&#xA;&#x9;=&gt; $Player.MaxHP = 0&#xD;&#xA;&#x9;=&gt; $Player.Opacity = .6&#xD;&#xA;&#x9;=&gt; $Player.Color = 0,0,0&#xD;&#xA;&#x9;put $Player into Threshold #at:300,125 #flip #follow #focus&#xD;&#xA;&#x9;transition In #immediate&#xD;&#xA;&#x9;zoom 1.2&#xD;&#xA;&#x9;await 1000&#xD;&#xA;&#x9;transition Out #duration:3000&#xD;&#xA;&#x9;await 500&#xD;&#xA;}" /></Folder></Folder></Folder></Project>