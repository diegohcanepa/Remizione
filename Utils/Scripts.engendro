D;&#xA;&#x9;add-trigger-area Grandma routine ThemeParkEntrance-GrandmaEncounter polygon 111,106;135,106;105,134;80,134&#xD;&#xA;&#x9;&#xD;&#xA;&#x9;add-light LampPost at 87,80 #scale:6,4 #passes:4 #color:255,248,143&#xD;&#xA;}&#xD;&#xA;&#xD;&#xA;Load ThemeParkEntrance&#xD;&#xA;{&#xD;&#xA;&#x9;play-sound Night #looped&#xD;&#xA;&#xD;&#xA;&#x9;put Grandma into this #at:145,110 #flip&#xD;&#xA;&#xD;&#xA;&#x9;if-flag theme_park_dog_escape_1&#xD;&#xA;&#x9;&#x9;play-music Track01 #looped&#xD;&#xA;&#x9;&#x9;put Edmund into this #at:-50,129 #focus #follow&#xD;&#xA;&#x9;endif&#xD;&#xA;}&#xD;&#xA;&#xD;&#xA;Enter ThemeParkEntrance&#xD;&#xA;{&#xD;&#xA;&#x9;//await 2000&#xD;&#xA;&#x9;move $Player to 37,124 await&#xD;&#xA;}" /><Script SourceCode="Thing ThemeParkEntrance-Foreground1 Class:Prop&#xD;&#xA;{&#xD;&#xA;&#x9;=&gt; PivotOrigin = RightBottom&#xD;&#xA;&#x9;=&gt; RenderLayer = Foreground&#xD;&#xA;&#xD;&#xA;&#x9;put this into ThemeParkEntrance #at:240,135&#xD;&#xA;}" /><Script SourceCode="Thing ThemeParkEntrance-Foreground2 Class:Prop&#xD;&#xA;{&#xD;&#xA;&#x9;=&gt; PivotOrigin = RightBottom&#xD;&#xA;&#x9;=&gt; RenderLayer = Foreground&#xD;&#xA;&#xD;&#xA;&#x9;put this into ThemeParkEntrance #at:240,135&#xD;&#xA;}" /><Script IsDocumentOpen="true" CaretOffset="110" SourceCode="Thing ThemeParkEntrance-LampPost Class:Prop&#xD;&#xA;{&#xD;&#xA;&#x9;=&gt; DepthOffset = -10&#xD;&#xA;&#x9;put this into ThemeParkEntrance #at:83,108&#xD;&#xA;}" /><Script IsDocumentOpen="true" CaretOffset="127" SourceCode="Thing ThemeParkEntrance-LampPostLight Class:Prop&#xD;&#xA;{&#xD;&#xA;&#x9;put this into ThemeParkEntrance #at:84,91&#xD;&#xA;&#x9;opacity-tween this Linear to .94 duration 80 #bounces:-1&#x9;&#xD;&#xA;}" /><Script SourceCode="Thing ThemeParkEntrance-LeftFencePatch Class:Prop&#xD;&#xA;{&#xD;&#xA;&#x9;=&gt; DepthOffset = -2&#xD;&#xA;&#x9;put this into ThemeParkEntrance #at:103,105&#xD;&#xA;}" /><Script SourceCode="Thing ThemeParkEntrance-LeftForegroundBushes Class:Prop&#xD;&#xA;{&#xD;&#xA;&#x9;=&gt; PivotOrigin = LeftBottom&#xD;&#xA;&#x9;=&gt; RenderLayer = Foreground&#xD;&#xA;&#xD;&#xA;&#x9;put this into ThemeParkEntrance #at:0,135&#xD;&#xA;}" /><Script IsDocumentOpen="true" CaretOffset="0" SourceCode="Thing ThemeParkEntrance-Raven Class:Prop&#xD;&#xA;{&#xD;&#xA;&#x9;put this into ThemeParkEntrance #at:34,36&#xD;&#xA;&#x9;&#xD;&#xA;&#x9;animation Default #prefix:Raven&#xD;&#xA;&#x9;frame 1 duration 3000&#xD;&#xA;&#x9;frame 2 duration 100&#xD;&#xA;&#x9;frame 1 duration 300&#xD;&#xA;&#x9;frame 1 duration 3000&#xD;&#xA;&#x9;frame 2 duration 100&#xD;&#xA;&#x9;frame 1 duration 300&#xD;&#xA;&#x9;frame 4 duration 1500&#xD;&#xA;&#x9;frame 1 duration 3000&#xD;&#xA;&#x9;frame 2 duration 100&#xD;&#xA;&#x9;frame 3 duration 300 #sound:Raven&#xD;&#xA;}" /><Script SourceCode="Thing ThemeParkEntrance-RightFencePatch Class:Prop&#xD;&#xA;{&#xD;&#xA;&#x9;=&gt; DepthOffset = -2&#xD;&#xA;&#x9;put this into ThemeParkEntrance #at:143,105&#xD;&#xA;}" /><Folder Name="Routines"><Script IsDocumentOpen="true" CaretOffset="1169" SourceCode="Routine ThemeParkEntrance-GrandmaEncounter&#xD;&#xA;{&#xD;&#xA;&#x9;say Grandma &quot;Joven... ¿podría pedirle un favor?&quot;&#xD;&#xA;&#x9;await-player-approach #target:Grandma&#xD;&#xA;&#x9;say $Player &quot;Edmundo a sus órdenes.&quot;&#xD;&#xA;&#x9;say Grandma &quot;Temo que mi perro se ha perdido.&quot;&#xD;&#xA;&#x9;say Grandma &quot;Entró al viejo parque de atracciones y no lo he vuelto a ver.&quot;&#xD;&#xA;&#x9;say Grandma &quot;¿Podría echar un vistazo dentro?&quot;&#xD;&#xA;&#x9;&#xD;&#xA;&#x9;create-dialog-block ThemeParkEntrance-GrandmaEncounter-Answers&#xD;&#xA;&#xD;&#xA;&#x9;add-dialog-option 1 &quot;Llevo prisa.&quot;&#xD;&#xA;&#x9;add-dialog-option 2 &quot;Delo por hecho.&quot;&#xD;&#xA;&#xD;&#xA;&#x9;await-dialog-block&#x9;&#xD;&#xA;}&#xD;&#xA;&#xD;&#xA;Routine ThemeParkEntrance-GrandmaEncounter-Answers&#xD;&#xA;{&#xD;&#xA;&#x9;if $DialogOptionId == 1&#xD;&#xA;&#x9;&#x9;say $Player &quot;Lo haría con todo gusto pero llevo algo de prisa.&quot;&#xD;&#xA;&#x9;&#x9;say $Player &quot;Razones de fuerza mayor. Tengo floja la cañería.&quot;&#xD;&#xA;&#x9;&#x9;say $Player &quot;Lo siento.&quot;&#xD;&#xA;&#x9;&#x9;terminate-dialog-block&#xD;&#xA;&#x9;&#x9;play-sound Fart #emitter:$Player #delay:1000&#xD;&#xA;&#x9;&#x9;move $Player to 228,121 await&#xD;&#xA;&#x9;&#x9;transition In await&#xD;&#xA;&#x9;&#x9;await-enter-room CreditsRoom&#xD;&#xA;&#x9;&#x9;return&#xD;&#xA;&#x9;endif&#xD;&#xA;&#xD;&#xA;&#x9;if $DialogOptionId == 2&#xD;&#xA;&#x9;&#x9;say $Player &quot;Claro, dulce abuelita. Estaré aquí con su mascota en menos de lo que canta un gallo.&quot;&#xD;&#xA;&#x9;&#x9;play-sound DoodleDoo #volume:.5 #delay:1500&#xD;&#xA;&#x9;&#x9;say Grandma &quot;Dios lo bendiga, jóven.&quot;&#xD;&#xA;&#x9;&#x9;say $Player &quot;¡Edmundo al rescate!&quot;&#xD;&#xA;&#x9;&#x9;move $Player to 103,96 await&#xD;&#xA;&#x9;&#x9;await 1000&#xD;&#xA;&#x9;&#x9;=&gt; $Player.Direction = Right&#xD;&#xA;&#x9;&#x9;play-sound Gesture1 #emitter:$Player&#xD;&#xA;&#x9;&#x9;await 500&#xD;&#xA;&#x9;&#x9;move $Player to 151,99 await&#xD;&#xA;&#x9;&#x9;terminate-dialog-block&#xD;&#xA;&#x9;&#x9;transition In #duration:1000 await&#xD;&#xA;&#x9;&#x9;await 1000&#xD;&#xA;&#x9;&#x9;put $Player into ThemePark #at:4,104 #focus #follow&#xD;&#xA;&#x9;&#x9;transition Out #duration:1000&#xD;&#xA;&#x9;&#x9;await-enter-room ThemePark&#xD;&#xA;&#x9;endif&#xD;&#xA;}" /></Folder><Folder Name="Stars"><Script SourceCode="Thing ThemeParkEntrance-Star1 Class:Prop&#xD;&#xA;{&#xD;&#xA;&#x9;put this into ThemeParkEntrance #at:28,6&#xD;&#xA;}&#xD;&#xA;&#xD;&#xA;Load ThemeParkEntrance-Star1&#xD;&#xA;{&#xD;&#xA;&#x9;=&gt; Opacity = .9&#xD;&#xA;&#x9;opacity-tween this Linear to .7 duration 120 #bounces:-1&#xD;&#xA;}" /><Script SourceCode="Thing ThemeParkEntrance-Star2 Class:Prop&#xD;&#xA;{&#xD;&#xA;&#x9;put this into ThemeParkEntrance #at:52,16&#xD;&#xA;}&#xD;&#xA;&#xD;&#xA;Load ThemeParkEntrance-Star2&#xD;&#xA;{&#xD;&#xA;&#x9;=&gt; Opacity = .9&#xD;&#xA;&#x