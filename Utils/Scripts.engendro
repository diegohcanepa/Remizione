igger $Player&#xD;&#xA;&#x9;&#xD;&#xA;&#x9;play-sound PickupSack #emitter:this&#xD;&#xA;&#x9;unparent this&#xD;&#xA;&#x9;set-flag threshold_sack_taken to true&#xD;&#xA;&#x9;=&gt; $InventoryEnabled = true&#xD;&#xA;&#x9;&#xD;&#xA;&#x9;add-item GadlingKnuckle&#xD;&#xA;&#x9;add-item CrudeKey&#xD;&#xA;&#x9;add-item PyritePebble&#xD;&#xA;}" /><Script IsDocumentOpen="true" CaretOffset="682" SourceCode="Thing Trunk Class:Trunk Cloneable Persistent&#xD;&#xA;{&#xD;&#xA;&#x9;=&gt; Atlas = Props&#xD;&#xA;&#x9;=&gt; Collider = 19,12;9,22;-5,15;3,4&#x9;&#xD;&#xA;&#x9;=&gt; DepthOffset = -4&#xD;&#xA;&#x9;=&gt; IsStatic = true&#xD;&#xA;&#x9;=&gt; LabelKey = &quot;Prop.Trunk&quot;&#xD;&#xA;&#x9;=&gt; ShadowOffset = -1,-6&#xD;&#xA;&#x9;=&gt; StandPoint = 0,19&#x9;&#xD;&#xA;&#x9;=&gt; Verb = Inspect&#xD;&#xA;&#x9;&#xD;&#xA;&#x9;animation Closed #prefix:Trunk&#xD;&#xA;&#x9;frame 1 duration 2000&#xD;&#xA;&#xD;&#xA;&#x9;animation Open #prefix:Trunk&#xD;&#xA;&#x9;frame 2 duration 2000&#xD;&#xA;}&#xD;&#xA;&#xD;&#xA;Load Trunk&#xD;&#xA;{&#xD;&#xA;&#x9;if IsOpen == true&#xD;&#xA;&#x9;&#x9;=&gt; Hotspot = 17,6;10,19;0,16;0,8;7,0&#xD;&#xA;&#x9;&#x9;play-animation this Open&#xD;&#xA;&#x9;else&#xD;&#xA;&#x9;&#x9;=&gt; Hotspot = 14,8;14,16;10,19;0,16;0,8;4,4&#xD;&#xA;&#x9;&#x9;play-animation this Close&#xD;&#xA;&#x9;endif&#xD;&#xA;}&#xD;&#xA;&#xD;&#xA;Outcome Trunk&#xD;&#xA;{&#xD;&#xA;&#x9;if Verb == Inspect&#xD;&#xA;&#x9;&#x9;echo &quot;Un viejo baúl de madera astillada. Tiene un cerrojo tosco de hierro.&quot;&#xD;&#xA;&#x9;else&#xD;&#xA;&#xD;&#xA;&#x9;&#x9;if-can-pickup-item-reward this&#xD;&#xA;&#x9;&#x9;&#x9;animate-actor $Player RaiseArm #preserve await&#xD;&#xA;&#x9;&#x9;&#x9;pickup-item-reward this&#xD;&#xA;&#x9;&#x9;&#x9;animate-actor $Player RaiseArm #reverse await&#x9;&#x9;&#x9;&#xD;&#xA;&#x9;&#x9;endif&#x9;&#x9;&#xD;&#xA;&#x9;endif&#xD;&#xA;}&#xD;&#xA;&#xD;&#xA;Outcome Trunk+CrudeKey&#xD;&#xA;{&#xD;&#xA;&#x9;if IsOpen == false&#xD;&#xA;&#x9;&#x9;animate-actor $Player PickUp&#xD;&#xA;&#