x9;frame 1 duration 300&#xD;&#xA;&#x9;frame 1 duration 3000&#xD;&#xA;&#x9;frame 2 duration 100&#xD;&#xA;&#x9;frame 1 duration 300&#xD;&#xA;&#x9;frame 4 duration 1500&#xD;&#xA;&#x9;frame 1 duration 3000&#xD;&#xA;&#x9;frame 2 duration 100&#xD;&#xA;&#x9;frame 3 duration 300 #sound:Raven&#xD;&#xA;}&#xD;&#xA;&#xD;&#xA;Outcome ThemeParkEntrance-Raven&#xD;&#xA;{&#xD;&#xA;&#x9;await 500&#xD;&#xA;&#x9;play-sound Gesture1&#xD;&#xA;&#x9;animate-actor $Player LookUp #preserve&#xD;&#xA;&#x9;await 1500&#xD;&#xA;&#x9;animate-actor $Player LookUp #reverse&#xD;&#xA;&#x9;await 300&#xD;&#xA;&#x9;say $Player &quot;Es un cuervo.&quot;&#xD;&#xA;&#x9;say $Player &quot;Bastante bien hecho para los pocos píxeles que hay.&quot;&#xD;&#xA;}" /><Script SourceCode="Thing ThemeParkEntrance-RightGatePatch Class:Prop&#xD;&#xA;{&#xD;&#xA;&#x9;=&gt; DepthOffset = -2&#xD;&#xA;&#x9;put this into ThemeParkEntrance #at:150,105&#xD;&#xA;}" /><Folder Name="Routines" IsExpanded="true"><Script IsDocumentOpen="true" CaretOffset="566" SourceCode="Routine ThemeParkEntrance-Father-Intro&#xD;&#xA;{&#xD;&#xA;&#x9;if-counter theme_park_entrance_interactions &lt; 2&#xD;&#xA;&#x9;&#x9;return&#xD;&#xA;&#x9;endif&#xD;&#xA;&#xD;&#xA;&#x9;set-flag theme_park_entrance_show_father_intro to false&#xD;&#xA;&#xD;&#xA;&#x9;put Father into $Room #at:242,118 #flip&#xD;&#xA;&#x9;move Father to 191,112 await&#xD;&#xA;&#x9;await 1000&#xD;&#xA;&#x9;say Father &quot;¿Edmundo Idle?&quot;&#xD;&#xA;&#x9;await 400&#xD;&#xA;&#x9;=&gt; $Player.Direction = Right&#xD;&#xA;&#x9;say $Player &quot;El mismo que viste y calza.&quot;&#xD;&#xA;&#x9;move $Player to 162,111 await&#xD;&#xA;&#x9;say $Player &quot;Vengo por el puesto de monaguillo ejecutivo.&quot;&#xD;&#xA;&#x9;say Father &quot;Buscamos una persona creyente, sagaz e inteligente.&quot;&#xD;&#xA;&#x9;play-sound Laugh&#xD;&#xA;&#x9;say $Player &quot;Entiendo. Mis disculpas.&quot;&#xD;&#xA;&#x9;await 800&#xD;&#xA;&#x9;stop-following&#xD;&#xA;&#x9;move $Player to -40,0 #relative&#xD;&#xA;&#x9;say Father &quot;¡Espere, el puesto es suyo!&quot;&#xD;&#xA;&#x9;animate-actor $Player LookBehind #preserve&#xD;&#xA;&#x9;play-sound Gesture1&#xD;&#xA;&#x9;await 800&#xD;&#xA;&#x9;animate-actor $Player LookBehind #reverse&#xD;&#xA;&#x9;move $Player to 168,114 await&#xD;&#xA;&#x9;follow $Player&#xD;&#xA;&#x9;say $Player &quot;¿En serio?&quot;&#xD;&#xA;&#x9;play-sound Laugh&#xD;&#xA;&#x9;say Father &quot;Está de suerte. Es el único postulante.&quot;&#xD;&#xA;&#x9;say $Player &quot;¡Qué genial!&quot;&#xD;&#xA;&#x9;say Father &quot;Bienvenido a la Órden del Supremo™.&quot;&#xD;&#xA;&#x9;say Father &quot;Nos dedicamos a neutralizar amenazas que atenten contra el equilibrio de la Creación.&quot;&#xD;&#xA;&#x9;say $Player &quot;Interesante.&quot;&#xD;&#xA;&#x9;&#xD;&#xA;&#x9;set-flag theme_park_entrance_gate_open to true&#xD;&#xA;&#x9;await-approach Father ThemeParkEntrance-Gate&#xD;&#xA;&#x9;=&gt; Father.Direction = Right&#xD;&#xA;&#x9;await 200&#xD;&#xA;&#x9;=&gt; $Player.Direction = Left&#xD;&#xA;&#x9;&#xD;&#xA;&#x9;say Father &quot;Venga conmigo.&quot;&#xD;&#xA;&#x9;say $Player &quot;Está cerrado.&quot;&#xD;&#xA;&#x9;play-sound Gesture1&#xD;&#xA;&#x9;animate-actor Father Read #preserve await&#xD;&#xA;&#x9;await 1000&#xD;&#xA;&#x9;say Father &quot;'[3:1] El Supremo posó su mano y el cerrojo cedió. Nadie se percató de la ganzúa.'&quot;&#xD;&#xA;&#x9;play-sound GooBoostFull&#xD;&#xA;&#x9;await 500&#xD;&#xA;&#x9;animate-actor Father Read #reverse&#xD;&#xA;&#x9;await 1500&#xD;&#xA;&#x9;play-sound FenceOpen&#xD;&#xA;&#x9;play-animation ThemeParkEntrance-Gate Open&#xD;&#xA;&#x9;await 1400&#xD;&#xA;&#x9;move Father to 151,98&#xD;&#xA;&#x9;say $Player &quot;¡Zambomba!&quot;&#xD;&#xA;&#x9;await-move Father&#xD;&#xA;&#x9;unparent Father&#xD;&#xA;&#x9;=&gt; ThemeParkEntrance-Gate.Verb = GoUp&#xD;&#xA;}" /></Folder><Folder Name="Stars"><Script SourceCode="Thing ThemeParkEntrance-Star1 Class:Prop&#xD;&#xA;{&#xD;&#xA;&#x9;put this into ThemeParkEntrance #at:73,18&#xD;&#xA;}&#xD;&#x