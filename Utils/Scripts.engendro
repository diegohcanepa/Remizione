;&#xA;&#x9;play-sound PneumaticHiss #pan:1&#x9;await&#xD;&#xA;&#x9;unparent RideCar&#xD;&#xA;&#x9;stop-sound RideCarLoop&#xD;&#xA;&#x9;await 300&#xD;&#xA;&#x9;play-sound DoorTunnelClose #pan:1&#xD;&#xA;}" /><Script SourceCode="Routine Hub-RideCarOut&#xD;&#xA;{&#xD;&#xA;&#x9;play-sound RideCarLoop #emitter:RideCar #fade:500 #looped&#xD;&#xA;&#x9;position-x-tween RideCar QuadraticIn to 400 duration 5000 await&#xD;&#xA;&#x9;unparent RideCar&#xD;&#xA;}" /><Script IsDocumentOpen="true" CaretOffset="580" SourceCode="Routine Hub-Sister-Intro&#xD;&#xA;{&#xD;&#xA;&#x9;put Sister into $Room #at:90,80&#xD;&#xA;&#x9;move Sister to 200,y await&#xD;&#xA;&#x9;say $Player &quot;¡Qué buen disfraz! ¡Un cerdo con hábitos de monja!&quot;&#x9;&#xD;&#xA;&#x9;say Sister &quot;No es un disfraz ni tampoco soy un cerdo.&quot;&#xD;&#xA;&#x9;say Sister &quot;Soy cerda. ¡Oink!&quot;&#xD;&#xA;&#x9;move $Player to 221,78 await&#x9;&#xD;&#xA;&#x9;say $Player &quot;Mis disculpas.&quot;&#xD;&#xA;&#x9;say Sister &quot;Trabajo para la Orden del Supremo™.&quot;&#xD;&#xA;&#x9;&#xD;&#xA;&#x9;create-dialog-block #routine:Hub-Sister-Intro-Dialog #prevent-quit&#xD;&#xA;&#x9;add-dialog-option 1 &quot;¿Qué tengo que hacer?&quot;&#xD;&#xA;&#x9;add-dialog-option 2 &quot;¿Hay algún peligro?&quot;&#xD;&#xA;&#x9;add-dialog-option 3 &quot;Estoy listo.&quot; #requires-read:1,2&#xD;&#xA;&#x9;await-dialog-block&#xD;&#xA;&#xD;&#xA;&#x9;say Sister &quot;¡Oink! Ojalá no muera descuartizado como los otros 36 monaguillos.&quot;&#xD;&#xA;&#x9;say $Player &quot;¿Cómo dijo?&quot;&#xD;&#xA;&#x9;say Sister &quot;Nada. No me haga caso.&quot;&#xD;&#xA;&#x9;say Sister &quot;¡Qué el Supremo esté contigo!&quot;&#xD;&#xA;&#xD;&#xA;&#x9;animate-actor Sister Read #preserve await&#xD;&#xA;&#x9;say Sister &quot;[7:3] El discípulo pidió la adición. El Supremo, fiel a sus principios, miró el importe y se desvaneció.&quot;&#xD;&#xA;&#x9;await 400&#xD;&#xA;&#x9;opacity-tween Sister Linear to 0 duration 300&#xD;&#xA;&#x9;play-sound Vanish await&#xD;&#xA;&#x9;unparent Sister&#xD;&#xA;&#x9;say $Player &quot;¡Zambomba!&quot;&#xD;&#xA;&#xD;&#xA;&#x9;save-game&#xD;&#xA;}&#xD;&#xA;&#xD;&#xA;Routine Hub-Sister-Intro-Dialog&#xD;&#xA;{&#xD;&#xA;&#x9;if $DialogOptionId == 1&#xD;&#xA;&#x9;&#x9;say $Player &quot;¿Qué tengo que hacer?&quot;&#xD;&#xA;&#x9;&#x9;say Sister &quot;Encuentre a Mandinga e intímelo a que se vaya al infierno.&quot;&#xD;&#xA;&#x9;&#x9;say $Player &quot;¡Ja, ja! ¡Qué ironía!&quot;&#xD;&#xA;&#x9;&#x9;return&#xD;&#xA;&#x9;endif&#xD;&#xA;&#xD;&#xA;&#x9;if $DialogOptionId == 2&#xD;&#xA;&#x9;&#x9;say $Player &quot;¿Qué tan peligroso es?&quot;&#xD;&#xA;&#x9;&#x9;say Sister &quot;¿Sabe artes marciales o defensa personal?&quot;&#xD;&#xA;&#x9;&#x9;say $Player &quot;Nada de eso.&quot;&#xD;&#xA;&#x9;&#x9;say Sister &quot;Estáun poco peligroso ahi adentro.&quot;&#xD;&#xA;&#x9;&#x9;say $Player &quot;Gané un concurso de romper sandías con la cabeza, ¿sirve?&quot;&#xD;&#xA;&#x9;&#x9;say Sister &quot;¡Oink! Eso le servirá.&quot;&#xD;&#xA;&#x9;&#x9;return&#xD;&#xA;&#x9;endif&#xD;&#xA;&#xD;&#xA;&#x9;if $DialogOptionId == 3&#xD;&#xA;&#x9;&#x9;terminate-dialog-block&#xD;&#xA;&#x9;&#x9;return&#xD;&#xA;&#x9;endif&#xD;&#xA;}" /></Folder></Folder><Folder Name="IntroTunnel"><Script IsDocumentOpen="true" CaretOffset="1063" SourceCode="Room IntroTunnel Class:GameRoom&#xD;&#xA;{&#xD;&#xA;&#x9;=&gt; LightMapColor = 10,10,10&#xD;&#xA;&#x9;=&gt; LightingSystem = true&#xD;&#xA;&#x9;=&gt; Zoom = 1.1&#xD;&#xA;&#x9;&#xD;&#xA;&#x9;add-light LeftTunnel at 20,52 #kind:Lantern #scale:8,8 #color:255,228,223&#xD;&#xA;&#x9;add-light Skeleton at 100,74 #kind:Lantern #scale:6,14 #color:155,48,43 #off #passes:3&#xD;&#xA;&#x9;add-light Monster at 203,74 #kind:Lantern #scale:8,14 #color:155,48,43 #off&#xD;&#xA;&#x9;add-light RightTunnel at 290,60 #kind:Lantern #scale:14,8 #color:155,68,63 #off #passes:2&#xD;&#xA;}&#xD;&#xA;&#xD;&#xA;Enter IntroTunnel&#xD;&#xA;{&#xD;&#xA;&#x9;put IntroTunnel-Skeleton into IntroTunnel #at:122,78&#xD;&#xA;&#x