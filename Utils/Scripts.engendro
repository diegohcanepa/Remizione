" /><Script SourceCode="Thing PotteryD Class:Pottery Cloneable&#xD;&#xA;{&#xD;&#xA;&#x9;=&gt; Collider = 8,9;10,13;-3,13;-1,9&#xD;&#xA;&#x9;=&gt; Hotspot = 7,4;6,12;1,12;0,4&#xD;&#xA;}" /><Script SourceCode="Thing PotteryE Class:Pottery Cloneable&#xD;&#xA;{&#xD;&#xA;&#x9;=&gt; Collider = 13,7;15,14;-4,14;-2,7&#xD;&#xA;&#x9;=&gt; Hotspot = 12,5;9,12;3,12;0,5&#xD;&#xA;}" /></Folder><Folder Name="Rock" IsExpanded="true"><Script IsDocumentOpen="true" CaretOffset="171" SourceCode="Thing LargeRockA Class:Prop Cloneable&#xD;&#xA;{&#xD;&#xA;&#x9;=&gt; Atlas = Props&#xD;&#xA;&#x9;=&gt; Collider = 38,18;46,26;46,31;32,36;29,34;20,34;8,30;2,30;4,21;16,17&#xD;&#xA;&#x9;=&gt; DepthOffset = -12&#xD;&#xA;&#x9;=&gt; Hotspot = 26,1;36,2;44,31;24,32;4,28;8,18;14,15;15,8&#xD;&#xA;&#x9;=&gt; RevealArea = 15,7,24,22&#xD;&#xA;&#x9;=&gt; IsStatic = true&#xD;&#xA;}" /><Script IsDocumentOpen="true" CaretOffset="230" SourceCode="Thing LargeRockB Class:Prop Cloneable&#xD;&#xA;{&#xD;&#xA;&#x9;=&gt; Atlas = Props&#xD;&#xA;&#x9;=&gt; Collider = 9,30;35,30;41,36;23,49;9,49;2,42&#xD;&#xA;&#x9;=&gt; DepthOffset = -14&#xD;&#xA;&#x9;=&gt; Hotspot = 21,1;30,1;38,37;21,48;5,45;10,16&#xD;&#xA;&#x9;=&gt; RevealArea = 11,12,23,18&#xD;&#xA;&#x9;=&gt; IsStatic = true&#xD;&#xA;}" /><Script IsDocumentOpen="true" CaretOffset="233" SourceCode="Thing LargeRockC Class:Prop Cloneable&#xD;&#xA;{&#xD;&#xA;&#x9;=&gt; Atlas = Props&#xD;&#xA;&#x9;=&gt; Collider = 9,30;35,30;42,37;24,50;9,50;2,42&#xD;&#xA;&#x9;=&gt; DepthOffset = -14&#xD;&#xA;&#x9;=&gt; Hotspot = 13,14;21,5;30,5;38,36;22,48;4,45&#xD;&#xA;&#x9;=&gt; RevealArea = 11,14,23,16&#xD;&#xA;&#x9;=&gt; IsStatic = true&#xD;&#xA;}" /></Folder></Folder><Folder Name="Rooms" IsExpanded="true"><Folder Name="Intro" IsExpanded="true"><Script IsDocumentOpen="true" CaretOffset="95" SourceCode="Room Intro Class:GameRoom&#xD;&#xA;{&#xD;&#xA;&#x9;=&gt; AtlasName = &quot;&quot;&#xD;&#xA;}&#xD;&#xA;&#xD;&#xA;Load Intro&#xD;&#xA;{&#xD;&#xA;&#x9;play-music-tag Idle&#xD;&#xA;}&#xD;&#xA;&#xD;&#xA;Enter Intro&#xD;&#xA;{&#xD;&#xA;&#x9;transition In #duration:0&#xD;&#xA;&#x9;transition Out #duration:2000&#xD;&#xA;&#x9;&#xD;&#xA;&#x9;epigrah &quot;Un día tu vida se va a terminar, y alguien va a tener que abrir tus cajones para decidir lo que se guarda, lo que se regala y lo que se tira.&quot;&#xD;&#xA;&#x9;&#xD;&#xA;&#x9;transition In #duration:1000 await&#xD;&#xA;&#x9;transition Out #duration:2000&#xD;&#xA;&#xD;&#xA;&#x9;narrate &quot;La muerte no es fin, sino umbral.&quot; Intro1&#xD;&#xA;&#x9;await 2000&#xD;&#xA;&#x9;narrate &quot;Alcanzar la redención... o pudrirse en la penitencia.&quot; Intro2&#xD;&#xA;&#x9;await 2000&#xD;&#xA;&#x9;narrate &quot;Los pasos escribirán la sentencia.&quot; Intro3&#xD;&#xA;}&#xD;&#xA;" /></Folder><Folder Name="Threshold" IsExpanded="true"><Script IsDocumentOpen="true" CaretOffset="51" SourceCode="Room Threshold Class:ProceduralRoom Persistent&#xD;&#xA;{&#xD;&#xA;&#x9;add-walk-area Default polygon 183,20;227,12;305,39;330,58;377,52;437,64;463,85;439,133;449,160;459,249;405,256;356,249;323,228;250,241;195,234;165,249;77,246;28,202;38,164;24,126;39,76;78,36;113,24&#xD;&#xA;}&#xD;&#xA;&#xD;&#xA;Load Threshold&#xD;&#xA;{&#xD;&#xA;&#x9;put CrossLargeA into this #at:240,135&#xD;&#xA;&#x9;play-sound Purgatory #fade:3000 #looped&#xD;&#xA;&#x9;play-music-tag Idle&#xD;&#xA;&#x9;&#xD;&#xA;&#x9;if-flag !threshold_sack_taken&#xD;&#xA;&#x9;&#x9;put Sack into this #at:144,60&#xD;&#xA;&#x9;endif&#xD;&#xA;&#xD;&#xA;&#x9;if-flag threshold_hopeless_present&#xD;&#xA;&#x9;&#x9;put Hopeless into this #at:130,70&#xD;&#xA;&#x9;endif&#xD;&#xA;}&#xD;&#xA;&#xD;&#xA;Enter Threshold&#xD;&#xA;{&#xD;&#xA;&#x9;if-flag !threshold_intro_shown&#xD;&#xA;&#x9;&#x9;set-flag threshold_intro_shown to true&#xD;&#xA;&#x9;&#x9;start-routine Threshold-Intro await&#xD;&#xA;&#x9;endif&#xD;&#xA;}" /><Script IsDocumentOpen="true" CaretOffset="589" SourceCode="Cloning Threshold&#xD;&#xA;{&#xD;&#xA;&#x9;clone Bonfire*Threshold #at:260,158 #parent:Threshold #persistent&#xD;&#xA;&#x9;&#xD;&#xA;&#x9;clone Fleshiness*Threshold #persistent&#xD;&#xA;&#x9;&#xD;&#xA;&#x9;clone LargeRockA*Threshold #at:240,100 #parent:Threshold&#xD;&#xA;&#x9;clone LargeRockC*Threshold #at:114,78 #parent:Threshold&#xD;&#xA;&#x9;&#xD;&#xA;&#x9;clone PotteryA*Threshold #at:220,94 #parent:Threshold #persistent&#xD;&#xA;&#x9;&#xD;&#xA;&#x9;clone GroundTorch*1*Threshold #at:115,82 #parent:Threshold #persistent&#xD;&#xA;&#x9;clone GroundTorch*2*Threshold #at:77,125 #parent:Threshold #persistent&#xD;&#xA;&#x9;clone GroundTorch*3*Threshold #at:285,100 #parent:Threshold #persistent&#xD;&#xA;&#x9;clone GroundTorch*4*Threshold #at:345,134 #parent:Threshold #persistent&#xD;&#xA;&#xD;&#xA;&#x9;clone Trunk*Threshold #at:300,160 #parent:Threshold #persistent&#xD;&#xA;&#x9;=&gt; Trunk*Threshold.ItemRewardName = &quot;SulfurStone&quot;&#xD;&#xA;&#xD;&#xA;&#x9;=&gt; GroundTorch*1*Threshold.IsLit = true&#xD;&#xA;&#x9;=&gt; GroundTorch*3*Threshold.IsLit = true&#xD;&#xA;}" /><Script IsDocumentOpen="true" CaretOffset="193" SourceCode="Thing Threshold-Inscription Class:Prop&#xD;&#xA;{&#xD;&#xA;&#x9;=&gt; DepthOffset = 4&#xD;&#xA;&#x9;=&gt; Hotspot = 8,-1;8,6;-1,6;-1,-1&#xD;&#xA;&#x9;=&gt; LabelKey = &quot;Misc.Inscription&quot;&#xD;&#xA;&#x9;=&gt; Verb = Examine&#x9;&#xD;&#xA;&#x9;&#xD;&#xA;&#x9;put this into Threshold #at:104,62&#xD;&#xA;}&#xD;&#xA;&#xD;&#xA;Outcome Threshold-Inscription&#xD;&#xA;{&#xD;&#xA;&#x9;echo &quot;«Aquí estuve y siempre voy a estar.»&quot;&#xD;&#xA;}" /><Folder Name="Routines" IsExpanded="true"><Script IsDocumentOpen="true" CaretOffset="206" SourceCode="Routine Threshold-Intro&#xD;&#xA;{&#xD;&#xA;&#x9;transition In #immediate&#xD;&#xA;&#x9;zoom %DefaultZoom&#xD;&#xA;&#x9;focus Hopeless&#xD;&#xA;&#x9;transition Out #duration:4000 await&#xD;&#xA;&#xD;&#xA;&#x9;await 1000&#xD;&#xA;&#xD;&#xA;&#x9;say Hopeless &quot;¡Maldita sea esta carne!&quot; #sound:SpeakerMale&#xD;&#xA;&#x9;&#xD;&#xA;&#x9;play-sound HopelessVanish #emitter:Hopeless&#xD;&#xA;&#x9;color-tween Hopeless CubicIn to 0,0,0 duration 800&#xD;&#xA;&#x9;play-sound HopelessDeath #emitter:Hopeless&#xD;&#xA;&#x9;animate-actor Hopeless Vanish #preserve await&#xD;&#xA;&#x9;put Fleshiness*Threshold into Threshold #at:128,70 #opacity:0&#xD;&#xA;&#x9;opacity-tween Hopeless CubicIn to 0 duration 1800&#xD;&#xA;&#xD;&#xA;&#x9;await 1000&#xD;&#xA;&#x9;&#xD;&#xA;&#x9;set-flag threshold_hopeless_present to false&#xD;&#xA;&#xD;&#xA;&#x9;await 1000&#xD;&#xA;&#xD;&#xA;&#x9;transition In #duration:1000 await&#xD;&#xA;&#x9;=&gt; $Player = InertShadow&#xD;&#xA;&#x9;put $Player into Threshold #at:300,125 #flip #follow #focus&#xD;&#xA;&#x9;await 1000&#xD;&#xA;&#x9;transition Out #duration:3000&#xD;&#xA;&#x9;await 500&#xD;&#xA;&#x9;narrate &quot;La sombra inerte no purga las culpas.&quot; Threshold_Intro1&#xD;&#xA;&#x9;await 1000&#xD;&#xA;&#x9;narrate &quot;Sin un cuerpo para padecer, el camino a la Redención está negado.&quot; Threshold_Intro2&#xD;&#xA;&#x9;follow $Player&#xD;&#xA;}" /></Folder></Folder></Folder></Project>