omeDoor == null&#xD;&#xA;&#x9;&#x9;return&#xD;&#xA;&#x9;endif&#xD;&#xA;&#xD;&#xA;&#x9;if $OutcomeDoor.LockType == GateLever&#xD;&#xA;&#x9;&#x9;say $Player &quot;Es una puerta de rejas. Se abre con una palanca mecánica.&quot;&#xD;&#xA;&#x9;&#x9;return&#xD;&#xA;&#x9;endif&#xD;&#xA;&#xD;&#xA;&#x9;if $OutcomeDoor.LockType != None&#xD;&#xA;&#x9;&#x9;if $OutcomeDoor.CanBeUnlockedWithPocketItem == false&#xD;&#xA;&#x9;&#x9;&#x9;if $OutcomeDoor.LockType == BronzeKey&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;say $Player &quot;Necesito una llave de bronce.&quot;&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;return&#xD;&#xA;&#x9;&#x9;&#x9;endif&#xD;&#xA;&#x9;&#x9;&#xD;&#xA;&#x9;&#x9;&#x9;if $OutcomeDoor.LockType == GoldenKey&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;say $Player &quot;Necesito una llave dorada.&quot;&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;return&#xD;&#xA;&#x9;&#x9;&#x9;endif&#xD;&#xA;&#x9;&#x9;else&#xD;&#xA;&#x9;&#x9;&#x9;=&gt;&gt; $OutcomeDoor.UnlockWithPocketItem()&#xD;&#xA;&#x9;&#x9;endif&#xD;&#xA;&#x9;endif&#xD;&#xA;&#xD;&#xA;&#x9;if $OutcomeDoor.IsOpen == false&#xD;&#xA;&#x9;&#x9;if $OutcomeDoor.DoorDirection == Up&#xD;&#xA;&#x9;&#x9;&#x9;animate-actor $Player Back #preserve&#xD;&#xA;&#x9;&#x9;&#x9;animate-actor $Player BackRaiseArm #preserve await&#xD;&#xA;&#x9;&#x9;&#x9;=&gt;&gt; $OutcomeDoor.Open()&#xD;&#xA;&#x9;&#x9;&#x9;animate-actor $Player BackRaiseArm #reverse #preserve await&#xD;&#xA;&#x9;&#x9;else&#xD;&#xA;&#x9;&#x9;&#x9;animate-actor $Player RaiseArm #preserve await&#xD;&#xA;&#x9;&#x9;&#x9;=&gt;&gt; $OutcomeDoor.Open()&#xD;&#xA;&#x9;&#x9;&#x9;animate-actor $Player RaiseArm #reverse #preserve await&#xD;&#xA;&#x9;&#x9;endif&#xD;&#xA;&#x9;&#xD;&#xA;&#x9;&#x9;if $HasPendingTurns == true&#xD;&#xA;&#x9;&#x9;&#x9;=&gt;&gt; $Player.Stand()&#xD;&#xA;&#x9;&#x9;&#x9;return&#xD;&#xA;&#x9;&#x9;endif&#xD;&#xA;&#x9;else&#xD;&#xA;&#x9;&#x9;if $OutcomeDoor.DoorDirection == Up&#xD;&#xA;&#x9;&#x9;&#x9;if $Player.HasThrowable == false&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;animate-actor $Player Back #preserve&#xD;&#xA;&#x9;&#x9