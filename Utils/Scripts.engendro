n Lit #prefix:Bonfire&#xD;&#xA;&#x9;frame 2 duration 10000&#xD;&#xA;}&#xD;&#xA;&#xD;&#xA;Load Bonfire&#xD;&#xA;{&#xD;&#xA;&#x9;if IsLit == true&#xD;&#xA;&#x9;&#x9;=&gt; DisplayNameKey = &quot;Prop.BonfireLit&quot;&#xD;&#xA;&#x9;&#x9;=&gt; Verb = Rest&#xD;&#xA;&#x9;else&#xD;&#xA;&#x9;&#x9;=&gt; DisplayNameKey = &quot;Prop.BonfireUnlit&quot;&#xD;&#xA;&#x9;&#x9;=&gt; Verb = Examine&#xD;&#xA;&#x9;endif&#xD;&#xA;}&#xD;&#xA;&#xD;&#xA;Outcome Bonfire Interruptible&#xD;&#xA;{&#xD;&#xA;&#x9;if Verb == Examine&#xD;&#xA;&#x9;&#x9;echo &quot;Una hoguera de azufre, dejada atrás por algún penitente.&quot; #voice:BonfireExamine1&#xD;&#xA;&#x9;&#x9;echo &quot;Encenderla recomponía el cuerpo para continuar con el castigo.&quot; #voice:BonfireExamine2&#xD;&#xA;&#x9;&#x9;return&#xD;&#xA;&#x9;endif&#xD;&#xA;}&#xD;&#xA;&#xD;&#xA;Outcome Bonfire+SulfurStone Interruptible&#xD;&#xA;{&#xD;&#xA;&#x9;if IsLit == true&#xD;&#xA;&#x9;&#x9;return&#xD;&#xA;&#x9;endif&#xD;&#xA;&#x9;&#xD;&#xA;&#x9;animate-actor $Player PickUp&#xD;&#xA;&#x9;await-animation-trigger $Player&#xD;&#xA;&#x9;consume-item SulfurStone&#xD;&#xA;&#x9;play-sound BonfireIgnition #emitter:this&#xD;&#xA;&#x9;&#xD;&#xA;&#x9;=&gt; IsLit = true&#xD;&#xA;&#x9;&#xD;&#xA;&#x9;reload this&#xD;&#xA;}" /><Script IsDocumentOpen="true" CaretOffset="486" SourceCode="Thing EmptySack Class:Prop Cloneable&#xD;&#xA;{&#xD;&#xA;&#x9;=&gt; ApproachBehavior = Over&#xD;&#xA;    =&gt; Atlas = Props&#xD;&#xA;    =&gt; DepthOffset = -2&#xD;&#xA;    =&gt; DisplayNameKey = &quot;Prop.EmptySack&quot;&#xD;&#xA;    =&gt; Hotspot = 0,0;7,0;7,7;0,7&#xD;&#xA;    =&gt; ShadowSpotSize = 5&#xD;&#xA;    =&gt; Scale = .8&#xD;&#xA;}&#xD;&#xA;&#xD;&#xA;Outcome EmptySack&#xD;&#xA;{&#xD;&#xA;&#x9;animate-actor $Player PickUp&#xD;&#xA;&#x9;await-animation-trigger $Player&#xD;&#xA;&#x9;play-sound PickupSack #emitter:this&#xD;&#xA;&#x9;unparent this&#xD;&#xA;&#x9;set-flag threshold_sack_taken to true&#xD;&#xA;&#x9;=&gt; $InventoryEnabled = true&#xD;&#xA;&#x9;&#xD;&#xA;&#x9;