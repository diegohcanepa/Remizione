ocumentOpen="true" CaretOffset="245" SourceCode="Routine ThemePark-Activation&#xD;&#xA;{&#x9;&#xD;&#xA;&#x9;if ThemePark-GhostCar.InCurrentRoom == true&#xD;&#xA;&#x9;&#x9;say $Player &quot;No voy a entrar caminando.&quot;&#xD;&#xA;&#x9;&#x9;move $Player to -10,0 #relative await&#xD;&#xA;&#x9;&#x9;return&#xD;&#xA;&#x9;endif&#xD;&#xA;&#xD;&#xA;&#x9;await 500&#xD;&#xA;&#x9;play-sound ElectricZapStrong #emitter:ThemePark-Tombstones&#xD;&#xA;&#x9;play-sound ZapLoop #emitter:ThemePark-Tombstones #looped&#xD;&#xA;&#x9;set-light ThemePark Remizione On&#xD;&#xA;&#x9;put ThemePark-RemizioneLight into ThemePark&#xD;&#xA;&#x9;put ThemePark-GhostCar into ThemePark #at:336,109&#xD;&#xA;&#x9;put ThemePark-RightTunnelPatch into ThemePark #at:449,109&#xD;&#xA;&#x9;&#xD;&#xA;&#x9;play-animation ThemePark-Foreground Red&#xD;&#xA;&#x9;play-animation ThemePark-Tombstones Red&#xD;&#xA;&#x9;&#xD;&#xA;&#x9;await 1500&#xD;&#xA;&#x9;&#xD;&#xA;&#x9;move $Player to 408,105 await&#xD;&#xA;&#x9;say $Player &quot;¡Sambombas! ¿Qué está pasando?&quot;&#xD;&#xA;&#x9;move $Player to 405,120 await&#xD;&#xA;&#x9;&#xD;&#xA;&#x9;play-sound GhostCarLoop #emitter:ThemePark-GhostCar #fade:2000 #looped&#xD;&#xA;&#x9;await 2000&#xD;&#xA;&#x9;x-tween ThemePark-GhostCar CubicOut to 388 duration 2000&#xD;&#xA;&#x9;await 1400&#xD;&#xA;&#x9;stop-sound GhostCarLoop &#xD;&#xA;&#x9;play-sound GhostCarStop #emitter:ThemePark-GhostCar await&#xD;&#xA;}" /><Script IsDocumentOpen="true" CaretOffset="172" SourceCode="Routine ThemePark-GhostTrainIntro&#xD;&#xA;{&#xD;&#xA;&#x9;play-sound DoodleDoo&#xD;&#xA;&#x9;say $Player &quot;Aquí está la criatura.&quot;&#xD;&#xA;&#x9;say $Player &quot;Las malas lenguas dicen que este juego está embrujado.&quot;&#xD;&#xA;}" /><Script IsDocumentOpen="true" CaretOffset="85" SourceCode="Routine ThemePark-Trigger-LeftTunnel&#xD;&#xA;{&#x9;&#xD;&#xA;&#x9;start-routine ThemePark-Activation await&#xD;&#xA;}" /><Script SourceCode="Routine ThemePark-Trigger-RightTunnel&#xD;&#xA;{&#x9;&#xD;&#xA;&#x9;start-routine ThemePark-Activation await&#xD;&#xA;}" /></Folder><Folder Name="Stars"><Script SourceCode="Thing ThemePark-Star1 Class:Prop&#xD;&#xA;{&#xD;&#xA;&#x9;put this into ThemePark #at:28,6&#xD;&#xA;}&#xD;&#xA;&#xD;&#xA;Load ThemePark-Star1&#xD;&#xA;{&#xD;&#xA;&#x9;=&gt; Opacity = .9&#xD;&#xA;&#x9;opacity-tween this Linear to .7 duration 120 #bounces:-1&#xD;&#xA;}" /><Script SourceCode="Thing ThemePark-Star2 Class:Prop&#xD;&#xA;{&#xD;&#xA;&#x9;put this into ThemePark #at:52,16&#xD;&#xA;}&#xD;&#xA;&#xD;&#xA;Load ThemePark-Star2&#xD;&#xA;{&#xD;&#xA;&#x9;=&gt; Opacity = .9&#xD;&#xA;&#x9;opacity-tween this Linear to .7 duration 100 #bounces:-1&#xD;&#xA;}" /><Script SourceCode="Thing ThemePark-Star3 Class:Prop&#xD;&#xA;{&#xD;&#xA;&#x9;=&gt; Scale = .5&#xD;&#xA;&#x9;put this into ThemePark #at:100,10&#xD;&#xA;}&#xD;&#xA;&#xD;&#xA;Load ThemePark-Star3&#xD;&#xA;{&#xD;&#xA;&#x9;=&gt; Opacity = .9&#xD;&#xA;&#x9;opacity-tween this Linear to .7 duration 160 #bounces:-1&#xD;&#xA;}" /><Script SourceCode="Thing ThemePark-Star4 Class:Prop&#xD;&#xA;{&#xD;&#xA;&#x9;put this into ThemePark #at:228,7&#xD;&#xA;}&#xD;&#xA;&#xD;&#xA;Load ThemePark-Star4&#xD;&#xA;{&#xD;&#xA;&#x9;=&gt; Opacity = .9&#xD;&#xA;&#x9;opacity-tween this Linear to .7 duration 100 #bounces:-1&#xD;&#xA;}" /><Script SourceCode="Thing ThemePark-Star5 Class:Prop&#xD;&#xA;{&#xD;&#xA;&#x9;put this into ThemePark #at:265,5&#xD;&#xA;}&#xD;&#xA;&#xD;&#xA;Load ThemePark-Star5&#xD;&#xA;{&#xD;&#xA;&#x9;=&gt; Opacity = .9&#xD;&#xA;&#x9;opacity-tween this Linear to .7 duration 100 #bounces:-1&#xD;&#xA;}" /></Folder></Folder><Folder Name="ThemeParkEntrance" IsExpanded="true"><Script IsDocumentOpen="true" IsDocumentSelected="true" CaretOffset="1052" SourceCode="Room ThemeParkEntrance Class:GameRoom Persistent&#xD;&#xA;{&#xD;&#xA;&#x9;=&gt; AllowFireflyParticles = true&#xD;&#xA;&#x9;=&gt; BrightnessModifier = .55&#xD;&#xA;&#x9;=&gt; DustParticleKind = None&#xD;&#xA;&#x9;=&gt; LightMapColor = 90,90,90&#xD;&#xA;&#x9;=&gt; LightingSystem = true&#xD;&#xA;&#xD;&#xA;&#x9;add-walk-area Default polygon 177,111;276,123;195,132;-23,133;-23,122;32,125;34,119;67,119;82,108;116,107;122,102;101,102;105,94;153,94;156,101;126,101;127,105;154,108;158,111&#xD;&#xA;&#x9;&#xD;&#xA;&#x9;add-trigger-area Entrance routine ThemeParkEntrance-Entrance polygon 135,85;158,85;158,102;135,102&#xD;&#xA;&#x9;&#xD;&#xA;&#x9;add-light LampPost at 87,80 #scale:6,4 #passes:4 #color:255,248,143&#xD;&#xA;}&#xD;&#xA;&#xD;&#xA;Load ThemeParkEntrance&#xD;&#xA;{&#xD;&#xA;&#x9;play-sound Night #looped&#xD;&#xA;&#x9;play-music ThemePark #looped&#xD;&#xA;&#x9;put Edmund into this #at:112,112&#xD;&#xA;&#x9;put Berta into this #at:227,124&#xD;&#xA;}&#xD;&#xA;&#xD;&#xA;Enter ThemeParkEntrance&#xD;&#xA;{&#xD;&#xA;&#x9;move Berta to 130,112&#xD;&#xA;&#x9;&#xD;&#xA;&#x9;await-move Edmund,Berta&#xD;&#xA;&#x9;&#xD;&#xA;&#x9;say Edmund &quot;¿Nadie te ha seguido, cierto?&quot;&#xD;&#xA;&#x9;say Berta &quot;Ni mi sombra, hermanito.&quot;&#xD;&#xA;&#x9;say Edmund &quot;No me perdonaría que la competencia nos robe la exclusiva.&quot;&#xD;&#xA;&#x9;say Berta &quot;Nuestros lectores van a quedar encantados con esta nueva investigación.&quot;&#xD;&#xA;&#x9;say Edmund &quot;¡Ni lo dudes, Berta!&quot;&#xD;&#xA;&#x9;say Edmund &quot;A propósito... ¿qué le dijiste a mamá?&quot;&#xD;&#xA;&#x9;say Berta &quot;Que ibamos al cine a ver 'Rápidos y Furiosos 35'.&quot;&#xD;&#xA;&#x9;say Edmund &quot;Genial.&quot;&#xD;&#xA;&#x9;say Edmund &quot;El año que viene cuando cumplamos 40 podríamos independizarnos.&quot;&#xD;&#xA;&#x9;say Berta &quot;¿Lo dices en serio, Edmundo?&quot;&#xD;&#xA;&#x9;say Edmund &quot;Claro que no.&quot;&#xD;&#xA;&#x9;say Berta &quot;¡Ja Ja Ja! ¡Qué susto me diste!&quot;&#xD;&#xA;&#x9;say Berta &quot;No hay tiempo que perder, hermanito.&quot;&#xD;&#xA;&#x9;move Berta to 120,95 #face:Right await&#xD;&#xA;&#x9;say Berta &quot;¡El movimiento se demuestra andando!&quot;&#xD;&#xA;&#x9;move Berta to 150,99 await&#xD;&#xA;}" /><Script SourceCode="Thing ThemeParkEntrance-Foreground1 Class:Prop&#xD;&#xA;{&#xD;&#xA;&#x9;=&gt; PivotOrigin = RightBottom&#xD;&#xA;&#x9;=&gt; RenderLayer = Foreground&#xD;&#xA;&#xD;&#xA;&#x9;put this into ThemeParkEntrance #at:240,135&#xD;&#xA;}" /><Script SourceCode="Thing ThemeParkEntrance-Foreground2 Class:Prop&#xD;&#xA;{&#xD;&#xA;&#x9;=&gt; PivotOrigin = RightBottom&#xD;&#xA;&#x9;=&gt; RenderLayer = Foreground&#xD;&#xA;&#xD;&#xA;&#x9;put this into ThemeParkEntrance #at:240,135&#xD;&#xA;}" /><Script SourceCode="Thing ThemeParkEntrance-LampPost Class:Prop&#xD;&#xA;{&#xD;&#xA;&#x9;=&gt; DepthOffset = -10&#xD;&#xA;&#x9;put this into ThemeParkEntrance #at:83,108&#xD;&#xA;}" /><Script SourceCode="Thing ThemeParkEntrance-LampPostLight Class:Prop&#xD;&#xA;{&#xD;&#xA;&#x9;put this into ThemeParkEntrance #at:84,91&#xD;&#xA;&#x9;opacity-tween this Linear to .94 duration 80 #bounces:-1&#x9;&#xD;&#xA;}" /><Script SourceCode="Thing ThemeParkEntrance-LeftFencePatch Class:Prop&#xD;&#xA;{&#xD;&#xA;&#x9;=&gt; DepthOffset = -2&#xD;&#xA;&#x9;put this into ThemeParkEntrance #at:103,105&#xD;&#xA;}" /><Script SourceCode="Thing ThemeParkEntrance-LeftForegroundBushes Class:Prop&#xD;&#xA;{&#xD;&#xA;&#x9;=&gt; PivotOrigin = LeftBottom&#xD;&#xA;&#x9;=&gt; RenderLayer = Foreground&#xD;&#xA;&#xD;&#xA;&#x9;put this into ThemeParkEntrance #at:0,135&#xD;&#xA;}" /><Script SourceCode="Thing ThemeParkEntrance-Raven Class:Prop&#xD;&#xA;{&#xD;&#xA;&#x9;put this into ThemeParkEntrance #at:34,36&#xD;&#xA;&#x9;&#xD;&#xA;&#x9;animation Default #prefix:Raven&#xD;&#xA;&#x9;frame 1 duration 3000&#xD;&#xA;&#x9;frame 2 duration 100&#xD;&#xA;&#x9;frame 1 duration 300&#xD;&#xA;&#x9;frame 1 duration 3000&#xD;&#xA;&#x9;frame 2 duration 100&#xD;&#xA;&#x9;frame 1 duration 300&#xD;&#xA;&#x9;frame 4 duration 1500&#xD;&#xA;&#x9;frame 1 duration 3000&#xD;&#xA;&#x9;frame 2 duration 100&#xD;&#xA;&#x9;frame 3 duration 300 #sound:Raven&#xD;&#xA;}" /><Script SourceCode="Thing ThemeParkEntrance-RightFencePatch Class:Prop&#xD;&#xA;{&#