D;&#xA;&#xD;&#xA;Load Bonfire&#xD;&#xA;{&#xD;&#xA;&#x9;if IsLit == true&#xD;&#xA;&#x9;&#x9;=&gt; DefaultVerb = Rest&#xD;&#xA;&#x9;else&#xD;&#xA;&#x9;&#x9;=&gt; DefaultVerb = Examine&#xD;&#xA;&#x9;endif&#xD;&#xA;}&#xD;&#xA;&#xD;&#xA;Outcome Bonfire&#xD;&#xA;{&#xD;&#xA;&#x9;if Verb == Examine&#xD;&#xA;&#x9;&#x9;echo &quot;Una hoguera dejada atrás por algún penitente. El azufre recompone la forma y abre el camino.&quot;&#xD;&#xA;&#x9;&#x9;return&#xD;&#xA;&#x9;endif&#xD;&#xA;&#xD;&#xA;&#x9;play-sound BonfireMenu&#xD;&#xA;&#x9;animate-actor $Player RestIn #preserve&#xD;&#xA;&#x9;=&gt;&gt; BeginRest()&#xD;&#xA;&#x9;await-camera&#xD;&#xA;&#x9;await-input&#xD;&#xA;&#x9;=&gt;&gt; EndRest()&#xD;&#xA;&#x9;play-sound BonfireMenu&#xD;&#xA;&#x9;zoom %DefaultZoom #duration:3000 #tween:CubicInOut&#xD;&#xA;&#x9;follow $Player&#x9;&#xD;&#xA;&#x9;animate-actor $Player RestOut&#xD;&#xA;}&#xD;&#xA;&#xD;&#xA;Outcome Bonfire+SulfurStone&#xD;&#xA;{&#xD;&#xA;&#x9;if IsLit == true&#xD;&#xA;&#x9;&#x9;echo &quot;La hoguera ya está encendida.&quot;&#xD;&#xA;&#x9;&#x9;return&#xD;&#xA;&#x9;endif&#xD;&#xA;&#x9;&#xD;&#xA;&#x9;animate-actor $Player PickUp&#xD;&#xA;&#x9;await-animation-trigger $Player&#xD;&#xA;&#x9;consume-item SulfurStone&#xD;&#xA;&#x9;play-sound BonfireIgnition #emitter:this&#xD;&#xA;&#x9;=&gt; IsLit = true&#xD;&#xA;&#x9;=&gt; $LastBonfire = this&#xD;&#xA;&#x9;reload this&#xD;&#xA;&#x9;save-game&#xD;&#xA;}" /><Script IsDocumentOpen="true" CaretOffset="608" SourceCode="Thing Fleshiness Class:Fleshiness Persistent Cloneable&#xD;&#xA;{&#xD;&#xA;&#x9;=&gt; ApproachBehavior = Over&#xD;&#xA;}&#xD;&#xA;&#xD;&#xA;Outcome Fleshiness&#xD;&#xA;{&#xD;&#xA;&#x9;if-entity $Player == InertShadow&#xD;&#xA;&#x9;&#x9;play-sound HopelessVanish #emitter:this&#x9;&#xD;&#xA;&#x9;&#x9;scale-tween $Player CubicIn to 0 duration 3000&#xD;&#xA;&#x9;&#x9;opacity-tween $Player Linear to 0 duration 1500 await&#xD;&#xA;&#x9;&#x9;put Penitent into $Room #at:128,68 #opacity:0 #scale:0&#xD;&#xA;&#x9;&#x9;opacity-tween this Linear to 0 duration 3000&#xD;&#xA;&#x9;&#x9;scale-tween this Linear to 0,2 duration 2500&#x9;&#x9;&#xD;&#xA;&#x9;&#x9;animate-actor Penitent RestIn #preserve&#xD;&#xA;&#x9;&#x9;opacity-tween Penitent Linear to 1 duration 2000&#xD;&#xA;&#x9;&#x9;scale-tween Penitent Linear to 1 duration 2500&#xD;&#xA;&#x9;&#x9;=&gt; Sack.DefaultVerb = Use&#xD;&#xA;&#x9;&#x9;unparent InertShadow&#xD;&#xA;&#x9;&#x9;=&gt; $Player = Penitent&#x9;&#xD;&#xA;&#x9;&#x9;=&gt; $Player.MaxHP = 2&#xD;&#xA;&#x9;&#x9;play-sound Fleshiness #emitter:$Player await&#xD;&#xA;&#x9;&#x9;unparent this&#xD;&#xA;&#x9;&#x9;=&gt; PotteryA*Threshold.DefaultVerb = Attack&#xD;&#xA;&#x9;&#x9;follow $Player&#xD;&#xA;&#x9;&#x9;x-tween $Player Linear to .15 duration 40 #bounces:-1 #relative&#xD;&#xA;&#x9;&#x9;unparent this&#xD;&#xA;&#x9;&#x9;&#xD;&#xA;&#x9;&#x9;narrate &quot;El penitente ya no era sombra.&quot; Fleshiness1&#xD;&#xA;&#x9;&#x9;await 1000&#xD;&#xA;&#x9;&#x9;narrate &quot;La carne duele pero limpia las culpas.&quot; Fleshiness2&#xD;&#xA;&#xD;&#xA;&#x9;&#x9;reset-tweens $Player&#xD;&#xA;&#x9;&#x9;animate-actor $Player RestOut await&#xD;&#xA;&#x9;&#x9;return&#xD;&#xA;&#x9;endif&#xD;&#xA;&#xD;&#xA;&#x9;animate-actor $Player PickUp&#xD;&#xA;&#x9;await-animation-trigger $Player&#xD;&#xA;&#x9;unparent this&#xD;&#xA;&#xD;&#xA;&#x9;=&gt; $Player.MaxHP += 2&#xD;&#xA;&#x9;if $Player.MaxHP == 2&#xD;&#xA;&#x9;&#x9;color-tween $Player Linear to 255,255,255 duration 6000&#xD;&#xA;&#x9;&#x9;play-sound Fleshiness #emitter:$Player await&#xD;&#xA;&#x9;endif&#xD;&#xA;}" /><Script IsDocumentOpen="true" CaretOffset="220" SourceCode="Thing GroundTorch Class:GroundTorch Cloneable Persistent&#xD;&#xA;{&#xD;&#xA;&#x9;=&gt; ApproachPosition = 12,22&#xD;&#xA;    =&gt; Collider = 8,24;1,24;2,21;7,21&#xD;&#xA;    =&gt; LabelKey = &quot;Prop.Torch&quot;&#xD;&#xA;    =&gt; Hotspot = 7,8;7,23;0,23;0,8&#xD;&#xA;    =&gt; IsStatic = true&#xD;&#xA;&#xD;&#xA;&#x9;animation Unlit #prefix:GroundTorch&#xD;&#xA;&#x9;frame 1 duration 10000&#xD;&#xA;&#x9;&#xD;&#xA;&#x9;animation Lit #prefix:GroundTorch&#xD;&#xA;&#x9;frame 2|5 duration 60&#xD;&#xA;}&#xD;&#xA;&#xD;&#xA;Load GroundTorch&#xD;&#xA;{&#xD;&#xA;&#x9;if IsLit == true&#xD;&#xA;&#x9;&#x9;=&gt; DefaultVerb = None&#xD;&#xA;&#x9;else&#xD;&#xA;&#x9;&#x9;=&gt; DefaultVerb = Examine&#xD;&#xA;&#x9;endif&#xD;&#xA;}&#xD;&#xA;&#xD;&#xA;Outcome GroundTorch&#xD;&#xA;{&#xD;&#xA;&#x9;echo &quot;Un palo envuelto en trapos sucios de brea. Solo necesita una chispa.&quot;&#xD;&#xA;}&#xD;&#xA;&#xD;&#xA;Outcome GroundTorch+PyritePebble&#xD;&#xA;{&#xD;&#xA;&#x9;if IsLit == true&#xD;&#xA;&#x9;&#x9;echo &quot;La antorcha ya esté encendida.&quot;&#xD;&#xA;&#x9;&#x9;return&#xD;&#xA;&#x9;endif&#xD;&#xA;&#x9;&#xD;&#xA;&#x9;animate-actor $Player RaiseArm #preserve await&#xD;&#xA;&#x9;consume-item PyritePebble&#xD;&#xA;&#x9;play-sound BonfireIgnition #emitter:this&#xD;&#xA;&#x9;=&gt; IsLit = true&#xD;&#xA;&#x9;animate-actor $Player RaiseArm #reverse await&#xD;&#xA;&#x9;reload this&#xD;&#xA;}" /><Script IsDocumentOpen="true" CaretOffset="187" SourceCode="Thing ItemOrb Class:ItemOrb Cloneable&#xD;&#xA;{&#xD;&#xA;}&#xD;&#xA;&#xD;&#xA;Outcome ItemOrb&#xD;&#xA;{&#xD;&#xA;&#x9;if-can-pickup-item-reward this&#xD;&#xA;&#x9;&#x9;animate-actor $Player PickUp&#xD;&#xA;&#x9;&#x9;await-animation-trigger $Player&#xD;&#xA;&#x9;&#x9;pickup-item-reward this&#xD;&#xA;&#x9;&#x9;unparent this&#xD;&#xA;&#x9;endif&#xD;&#xA;}" /><Script IsDocumentOpen="true" CaretOffset="642" SourceCode="Thing Sack Class:Prop Cloneable&#xD;&#xA;{&#xD;&#xA;&#x9;=&gt; ApproachBehavior = Over&#xD;&#xA;    =&gt; Atlas = Props&#xD;&#xA;    =&gt; LabelKey = &quot;Prop.Sack&quot;&#xD;&#xA;    =&gt; Hotspot = 0,0;7,0;7,7;0,7&#xD;&#xA;    =&gt; RenderLayer = Background&#xD;&#xA;    =&gt; ShadowSpotSize = 5&#xD;&#xA;    =&gt; Scale = .8&#xD;&#xA;    =&gt; DefaultVerb = Examine&#xD;&#xA;}&#xD;&#xA;&#xD;&#xA;Outcome Sack&#xD;&#xA;{&#xD;&#xA;&#x9;echo &quot;Una tripa seca y ajada que conserva la forma de un recipiente de cuero.&quot;&#xD;&#xA;&#xD;&#xA;&#x9;animate-actor $Player PickUp&#xD;&#xA;&#x9;await-animation-trigger $Player&#xD;&#xA;&#x9;&#xD;&#xA;&#x9;play-sound PickupSack #emitter:this&#xD;&#xA;&#x9;unparent this&#xD;&#xA;&#x9;set-flag threshold_sack_taken to true&#xD;&#xA;&#x9;=&gt; $InventoryEnabled = true&#xD;&#xA;&#x9;&#xD;&#xA;&#x9;add-item GadlingKnuckle&#xD;&#xA;&#x9;add-item CrudeKey&#xD;&#xA;&#x9;add-item PyritePebble #amount:4&#xD;&#xA;}" /><Script IsDocumentOpen="true" CaretOffset="232" SourceCode="Thing Trunk Class:Trunk Cloneable Persistent&#xD;&#xA;{&#xD;&#xA;&#x9;=&gt; ApproachPosition = 0,19&#xD;&#xA;&#x9;=&gt; Atlas = Props&#xD;&#xA;&#x9;=&gt; Collider = 19,12;9,22;-5,15;3,4&#x9;&#xD;&#xA;&#x9;=&gt; DefaultVerb = Examine&#xD;&#xA;&#x9;=&gt; DepthOffset = -3&#xD;&#xA;&#x9;=&gt; IsStatic = true&#xD;&#xA;&#x9;=&gt; LabelKey = &quot;Prop.Trunk&quot;&#xD;&#xA;&#x9;&#xD;&#xA;&#x9;animation Closed #prefix:Trunk&#xD;&#xA;&#x9;frame 1 duration 2000&#xD;&#xA;&#xD;&#xA;&#x9;animation Open #prefix:Trunk&#xD;&#xA;&#x9;frame 2 duration 2000&#xD;&#xA;}&#xD;&#xA;&#xD;&#xA;Load Trunk&#xD;&#xA;{&#xD;&#xA;&#x9;if IsOpen == true&#xD;&#xA;&#x9;&#x9;=&gt; Hotspot = 17,6;10,19;0,16;0,8;7,0&#xD;&#xA;&#x9;&#x9;play-animation this Open&#xD;&#xA;&#x9;else&#xD;&#xA;&#x9;&#x9;=&gt; Hotspot = 14,8;14,16;10,19;0,16;0,8;4,4&#xD;&#xA;&#x9;&#x9;play-animation this Close&#xD;&#xA;&#x9;endif&#xD;&#xA;}&#xD;&#xA;&#xD;&#xA;Outcome Trunk&#xD;&#xA;{&#xD;&#xA;&#x9;if Verb == Examine&#xD;&#xA;&#x9;&#x9;echo &quot;Un viejo baúl de madera astillada, ensamblado a golpes. Un cerrojo tosco de hierro lo mantiene cerrado.&quot;&#xD;&#xA;&#x9;else&#xD;&#xA;&#xD;&#xA;&#x9;&#x9;if-can-pickup-item-reward this&#xD;&#xA;&#x9;&#x9;&#x9;animate-actor $Player RaiseArm #preserve await&#xD;&#xA;&#x9;&#x9;&#x9;pickup-item-reward this&#xD;&#xA;&#x9;&#x9;&#x9;animate-actor $Player RaiseArm #reverse await&#x9;&#x9;&#x9;&#xD;&#xA;&#x9;&#x9;endif&#x9;&#x9;&#xD;&#xA;&#x9;endif&#xD;&#xA;}&#xD;&#xA;&#xD;&#xA;Outcome Trunk+