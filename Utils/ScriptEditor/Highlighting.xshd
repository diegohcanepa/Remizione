		<!-- Axis -->
		<Keywords fontWeight="regular" foreground="DodgerBlue">
			<Word>x</Word>
			<Word>y</Word>
		</Keywords>

		<!-- Digits -->
		<Rule fontWeight="bold" foreground="Black">
			\b0[xX][0-9a-fA-F]+  # hex number
			|    \b
			(    \d+(\.[0-9]+)?   #number with optional floating point
			|    \.[0-9]+         #or just starting with floating point
			)
			([eE][+-]?[0-9]+)? # optional exponent
		</Rule>

		<!-- Constants -->
		<Rule foreground="BlueViolet">
			\%\w+
		</Rule>

		<!-- Flags -->
		<Rule fontWeight="regular" foreground="BlueViolet">
			\#\w+([-]\w+)*
		</Rule>

		<!-- Verbs -->
		<Rule fontWeight="bold" foreground="Purple">
			\?\w+([-]\w+)*
		</Rule>

	</RuleSet>
</SyntaxDefinition>