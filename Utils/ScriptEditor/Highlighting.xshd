<SyntaxDefinition name="TSL" xmlns="http://icsharpcode.net/sharpdevelop/syntaxdefinition/2008">

	<Color name="Comment" foreground="Green" />
	<Color name="String" foreground="Red" />

	<!-- This is the main ruleset. -->
	<RuleSet>
		<Span color="Comment" begin="//" />
		<Span color="String">
			<Begin>"</Begin>
			<End>"</End>
		</Span>

		<!-- [+] -->
		<Keywords fontWeight="bold" foreground="#3d882e" >
			<Word>[+]</Word>
		</Keywords>

		<!-- [-] -->
		<Keywords fontWeight="bold" foreground="#f54c4c" >
			<Word>[-]</Word>
		</Keywords>

		<!-- Script Types -->
		<Keywords fontWeight="bold" foreground="Purple">
			<Word>{</Word>
			<Word>}</Word>
			<Word>Cloning</Word>
			<Word>Declaration</Word>
			<Word>Initialization</Word>
			<Word>Room </Word>
			<Word>EnterRoom</Word>
			<Word>Enter </Word>
			<Word>Entering </Word>
			<Word>Exiting </Word>
			<Word>Load </Word>
			<Word>Unload </Word>
			<Word>Outcome </Word>
			<Word>Routine </Word>
			<Word>NewSession</Word>
			<Word>Thing </Word>
		</Keywords>

		<!-- Identifiers -->
		<Keywords fontWeight="regular" foreground="Purple">
			<Word>Class:</Word>
			<Word>Cloneable</Word>
			<Word>Interruptible</Word>
			<Word>Persistent</Word>
		</Keywords>

		<!-- Identifiers -->
		<Keywords fontWeight="bold" foreground="Blue">
			<Word>??</Word>
		</Keywords>

		<!-- Session members -->
		<Rule fontWeight="bold" foreground="Black">
			\$\w+([-]\w+)*
		</Rule>

		<!-- Identifiers -->
		<Keywords fontWeight="regular" foreground="Green">
			<Word>set-achievement</Word>
		</Keywords>

		<!-- Flag commands -->
		<Keywords fontWeight="bold" foreground="MediumVioletRed">
			<Word>set-counter</Word>
			<Word>set-flag</Word>
			<Word>toggle-flag</Word>
		</Keywords>

		<!-- Statements -->
		<Keywords fontWeight="regular" foreground="Blue" >
			<Word>counter</Word>
