{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "Prop.schema.json",
  "title": "Prop Data File",
  "type": "object",
  "properties": {
    "data": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Prop"
      }
    }
  },
  "required": [
    "data"
  ],
  "$defs": {
    "Prop": {
      "type": "object",
      "allOf": [
        {
          "$ref": "./Thing.schema.json"
        }
      ],
      "unevaluatedProperties": false
    }
  }
}