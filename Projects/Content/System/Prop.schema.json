{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "Prop.schema.json",
  "type": "object",
  "properties": {
    "data": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Prop"
      }
    }
  },
  "required": [
    "data"
  ],
  "$defs": {
    "Prop": {
      "allOf": [
        {
          "$ref": "./Thing.schema.json"
        },
        {
          "type": "object",
          "properties": {
            "placements": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "Floor",
                  "WallFrontBase",
                  "WallFrontHang",
                  "WallLeftBase",
                  "WallLeftHang",
                  "WallRightBase",
                  "WallRightHang",
                  "Ceiling"
                ]
              }
            },
            "requiresPlaceholder": {
              "type": "boolean",
              "default": false
            }
          }
        }
      ],
      "unevaluatedProperties": false
    }
  }
}