{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "RunDefinition.schema.json",
  "title": "Run Definition",
  "type": "object",
  "properties": {
    "data": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/RunDefinition"
      }
    }
  },
  "required": [
    "data"
  ],
  "$defs": {
    "RunDefinition": {
      "allOf": [
        {
          "$ref": "./Definition.schema.json"
        },
        {
          "type": "object",
          "properties": {
            "floors": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/Floor"
              }
            }
          },
          "required": [
            "floors"
          ]
        }
      ],
      "unevaluatedProperties": false
    },
    "Floor": {
      "type": "object",
      "properties": {
        "allowedPuzzles": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "BronzeKey",
              "GateLever"
            ]
          }
        },
        "darkness": {
          "type": "boolean"
        },
        "roomCount": {
          "type": "integer",
          "minimum": 5
        },
        "theme": {
          "type": "string",
          "enum": [
            "Castle"
          ]
        }
      },
      "required": [
        "roomCount",
        "theme"
      ],
      "additionalProperties": false
    }
  }
}