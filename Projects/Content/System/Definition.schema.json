{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "Definition.schema.json",
  "type": "object",
  "properties": {
    "name": { 
      "type": "string" 
    },
    "effects": {
      "type": "array",
      "items": { 
        "$ref": "./EffectDescriptor.schema.json" 
      }
    },
    "requiredCycles": {
      "type": "integer",
      "minimum": 0
    },   
    "requiredRoom": {
      "type": "string"
    },   
    "spawnWeight": {
      "type": "number",
      "default": 1.0,
      "minimum": 0.0,
      "maximum": 1.0
    },
    "unlockMode": {
      "$ref": "./enums.schema.json#/$defs/UnlockMode"
    }
  },
  "required": [
    "name"
  ]
}