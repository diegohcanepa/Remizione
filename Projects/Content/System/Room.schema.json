{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "Room.schema.json",
  "title": "Room Data File",
  "type": "object",
  "properties": {
    "data": {
      "type": "array",
      "description": "Lista de definiciones de Rooms.",
      "items": {
        "$ref": "#/$defs/Room"
      }
    }
  },
  "required": [
    "data"
  ],
  "$defs": {
    "Room": {
      "description": "Definición completa de un Room.",
      "allOf": [
        {
          "$ref": "./Entity.schema.json"
        },
        {
          "type": "object",
          "properties": {
            "allowPools": {
              "type": "string"
            },
            "allowTags": {
              "type": "string"
            },
            "denyPools": {
              "type": "string"
            },
            "denyTags": {
              "type": "string"
            },
            "doorDown": {
              "type": "string"
            },
            "doorLeft": {
              "type": "string"
            },
            "doorRight": {
              "type": "string"
            },
            "doorUp": {
              "type": "string"
            },
            "doorStyle": {
              "type": "string",
              "default": "Wooden",
              "enum": [
                "Wooden",
                "Gate"
              ]
            },
            "exactMatch": {
              "type": "boolean",
              "default": false
            },
            "exitApproachPosition": {
              "type": "string"
            },
            "exitHotspot": {
              "type": "string"
            },            
            "isMandatory": {
              "type": "boolean",
              "default": false
            },
            "lockType": {
              "type": "string",
              "default": "None",
              "enum": [
                "None",
                "Padlock"
              ]
            },
            "requiresDeadEnd": {
              "type": "boolean"
            },
            "roomType": {
              "type": "string",
              "default": "Corridor",
              "enum": [
                "Corridor",
                "SideRoom"
              ]
            },
            "sideRoomCategory": {
              "type": "string",
              "default": "None",
              "enum": [
                "None",
                "Standard",
                "Save",
                "Treasure"
              ]
            },
            "allowEnemies": {
              "type": "boolean",
              "default": true
            },
            "guardActorPosition": {
              "type": "string"
            },
            "leftGatePosition": {
              "type": "string"
            },
            "rightGatePosition": {
              "type": "string"
            },
            "interactiveActorPosition": {
              "type": "string"
            },
            "playerPosition": {
              "type": "string"
            },
            "leverPosition": {
              "type": "string"
            },
            "musicTag": {
              "type": "string"
            },
            "placeholders": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "position": {
                    "type": "string"
                  },
                  "allowTags": {
                    "type": "string"
                  },
                  "placement": {
                    "type": "string",
                    "enum": [
                      "Floor",
                      "WallFrontBase",
                      "WallFrontHang",
                      "WallLeftBase",
                      "WallLeftHang",
                      "WallRightBase",
                      "WallRightHang",
                      "Ceiling"
                    ]
                  },
                  "fillChance": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  }
                },
                "required": [
                  "position",
                  "placement"
                ],
                "additionalProperties": false
              }
            },
            "theme": {
              "type": "string",
              "default": "BlueStone",
              "enum": [
                "BlueStone"
              ]
            },
            "walkArea": {
              "type": "string"
            },
            "walls": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "required": [
            "roomType",
            "walkArea"
          ]
        }
      ],
      "unevaluatedProperties": false
    }
  }
}