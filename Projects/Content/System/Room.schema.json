{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "Room.schema.json",
    "title": "Room schema",
    "allOf": [
        {
            "$ref": "./Config.schema.json"
        },
        {
            "type": "object",
            "properties": {
                "allowPools": {
                    "type": "string",
                    "description": "Lista de etiquetas usadas para aplicar restricciones de 'scope' (Tags)."
                },
                "allowTags": {
                    "type": "string",
                    "description": "Lista de etiquetas usadas para aplicar restricciones de 'scope' (Tags)."
                },
                "denyPools": {
                    "type": "string",
                    "description": "Lista de etiquetas usadas para aplicar restricciones de 'scope' (Tags)."
                },
                "denyTags": {
                    "type": "string",
                    "description": "Lista de etiquetas usadas para aplicar restricciones de 'scope' (Tags)."
                },
                "lockType": {
                    "type": "string",
                    "default": "None",
                    "enum": [
                        "None",
                        "Padlock"
                    ],
                    "description": "Tipo de lock."
                },
                "maxEnemies": {
                    "type": "integer",
                    "minimum": -1,
                    "description": "Número máximo de veces que este elemento puede aparecer por 'room'."
                },
                "maxProps": {
                    "type": "integer",
                    "minimum": -1,
                    "description": "Número máximo de veces que este elemento puede aparecer por 'room'."
                },
                "placement": {
                    "type": "string",
                    "enum": [
                        "Any",
                        "Left",
                        "Right",
                        "Middle",
                        "MiddleOrLeft",
                        "MiddleOrRight"
                    ],
                    "default": "Any",
                    "description": "Lugares donde puede ser spawneado el room."
                },
                "template": {
                    "type": "string",
                    "description": "Nombre del template de room a instanciar."
                }
            },
            "required": [
                "template"
            ]
        }
    ]
}