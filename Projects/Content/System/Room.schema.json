{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "Room.schema.json",
  "title": "Room Data File",
  "type": "object",
  "properties": {
    "data": {
      "type": "array",
      "description": "Lista de definiciones de Rooms.",
      "items": {
        "$ref": "#/$defs/Room"
      }
    }
  },
  "required": [
    "data"
  ],
  "$defs": {
    "FeaturedActor": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "position": {
          "type": "string"
        },
        "facingDirection": {
          "type": "string",
          "enum": [
            "Left",
            "Right"
          ],
          "default": "Right"
        }
      },
      "required": [
        "name",
        "position",
        "facingDirection"
      ],
      "additionalProperties": false
    },
    "Room": {
      "description": "Definición completa de un Room.",
      "allOf": [
        {
          "$ref": "./Entity.schema.json"
        },
        {
          "type": "object",
          "properties": {
            "allowPools": {
              "type": "string"
            },
            "allowTags": {
              "type": "string"
            },
            "denyPools": {
              "type": "string"
            },
            "denyTags": {
              "type": "string"
            },
            "doorDown": {
              "type": "string"
            },
            "doorLeft": {
              "type": "string"
            },
            "doorRight": {
              "type": "string"
            },
            "doorUp": {
              "type": "string"
            },
            "exactMatch": {
              "type": "boolean",
              "default": false
            },
            "lockType": {
              "type": "string",
              "default": "None",
              "enum": [
                "None",
                "GoldenKey",
                "SilverKey"
              ]
            },
            "roomCategory": {
              "type": "string",
              "default": "Standard",
              "enum": [
                "Start",
                "Boss",
                "Treasure",
                "Save",
                "Special",
                "Secret",
                "Standard"
              ]
            },
            "allowEnemies": {
              "type": "boolean",
              "default": true
            },
            "featuredActor": {
              "$ref": "#/$defs/FeaturedActor"
            },            
            "interactiveActorPosition": {
              "type": "string"
            },
            "leverPosition": {
              "type": "string"
            },
            "lightMapColor": {
              "type": "string"
            },
            "lights": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "color": {
                    "type": "string"
                  },
                  "position": {
                    "type": "string"
                  },
                  "scale": {
                    "type": "string"
                  }
                },
                "required": [
                  "position",
                  "scale"
                ],
                "additionalProperties": false
              }
            },
            "musicTag": {
              "type": "string"
            },
            "placeholders": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "position": {
                    "type": "string"
                  },
                  "allowTags": {
                    "type": "string"
                  },
                  "placement": {
                    "type": "string",
                    "enum": [
                      "Floor",
                      "WallFrontBase",
                      "WallFrontHang",
                      "WallLeftBase",
                      "WallLeftHang",
                      "WallRightBase",
                      "WallRightHang",
                      "Ceiling"
                    ]
                  },
                  "fillChance": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  }
                },
                "required": [
                  "position",
                  "placement"
                ],
                "additionalProperties": false
              }
            },
            "runModifiers": {
              "type": "string"
            },
            "theme": {
              "type": "string",
              "default": "BlueStone",
              "enum": [
                "BlueStone"
              ]
            },
            "walkArea": {
              "type": "string"
            },
            "walls": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "required": [
            "roomCategory",
            "walkArea"
          ]
        }
      ],
      "unevaluatedProperties": false
    }
  }
}