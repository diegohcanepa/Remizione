{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "Room.schema.json",
  "title": "Room Data File",
  "type": "object",
  "properties": {
    "data": {
      "type": "array",
      "description": "Lista de definiciones de Rooms.",
      "items": {
        "$ref": "#/$defs/Room"
      }
    }
  },
  "required": [
    "data"
  ],
  "$defs": {
    "Room": {
      "allOf": [
        {
          "$ref": "./Entity.schema.json"
        },
        {
          "type": "object",
          "properties": {
            "allowPools": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "$ref": "enums.schema.json#/$defs/Tag"
              }
            },
            "allowTags": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "$ref": "enums.schema.json#/$defs/Tag"
              }
            },
            "denyPools": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "$ref": "enums.schema.json#/$defs/Tag"
              }
            },
            "denyTags": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "$ref": "enums.schema.json#/$defs/Tag"
              }
            },
            "minEnemies": {
              "type": "integer",
              "default": 0,
              "minimum": 0
            },
            "maxEnemies": {
              "type": "integer",
              "default": 0,
              "minimum": 0
            },
            "placeholders": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "position": {
                    "type": "string"
                  },
                  "allowTags": {
                    "type": "array",
                    "uniqueItems": true,
                    "items": {
                      "$ref": "enums.schema.json#/$defs/Tag"
                    }
                  },
                  "contentType": {
                    "$ref": "enums.schema.json#/$defs/PlaceholderContentType"
                  },
                  "fillChance": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  },
                  "spawnRule": {
                    "$ref": "enums.schema.json#/$defs/PlaceholderSpawnRule"
                  }
                },
                "required": [
                  "position"
                ],
                "additionalProperties": false
              }
            },
            "runModifiers": {
              "type": "string"
            }
          }
        }
      ]
    }
  }
}