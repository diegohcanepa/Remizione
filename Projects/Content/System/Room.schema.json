{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "Room.schema.json",
  "title": "Room Data File",
  "type": "object",
  "properties": {
    "data": {
      "type": "array",
      "description": "Lista de definiciones de Rooms.",
      "items": {
        "$ref": "#/$defs/Room"
      }
    }
  },
  "required": [
    "data"
  ],
  "$defs": {
    "FeaturedActor": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "position": {
          "type": "string"
        },
        "facingDirection": {
          "$ref": "enums.schema.json#/$defs/FacingDirection"
        }
      },
      "required": [
        "name",
        "position",
        "facingDirection"
      ],
      "additionalProperties": false
    },
    "Room": {
      "description": "Definición completa de un Room.",
      "allOf": [
        {
          "$ref": "./Entity.schema.json"
        },
        {
          "type": "object",
          "properties": {
            "allowPools": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "$ref": "enums.schema.json#/$defs/Tag"
              }
            },
            "allowTags": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "$ref": "enums.schema.json#/$defs/Tag"
              }
            },
            "denyPools": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "$ref": "enums.schema.json#/$defs/Tag"
              }
            },
            "denyTags": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "$ref": "enums.schema.json#/$defs/Tag"
              }
            },
            "allowEnemies": {
              "type": "boolean",
              "default": true
            },
            "placeholders": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "position": {
                    "type": "string"
                  },
                  "allowTags": {
                    "type": "array",
                    "uniqueItems": true,
                    "items": {
                      "$ref": "enums.schema.json#/$defs/Tag"
                    }
                  },
                  "placement": {
                    "$ref": "enums.schema.json#/$defs/PlacementType"
                  },
                  "fillChance": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  },
                  "spawnRule": {
                    "$ref": "enums.schema.json#/$defs/PlaceholderSpawnRule"
                  }
                },
                "required": [
                  "position",
                  "placement"
                ],
                "additionalProperties": false
              }
            },
            "runModifiers": {
              "type": "string"
            },
            "walkArea": {
              "type": "string"
            },
            "walls": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "required": [
            "walkArea"
          ]
        }
      ]
    }
  }
}