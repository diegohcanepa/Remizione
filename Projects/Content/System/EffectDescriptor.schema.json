{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "EffectDescriptor.schema.json",
  "title": "Effect Descriptor Data File",
  "type": "object",
  "properties": {
    "data": {
      "type": "array",
      "description": "Una lista de EffectDescriptor.",
      "items": {
        "$ref": "#/$defs/Effect"
      }
    }
  },
  "required": [
    "data"
  ],
  "$defs": {
    "EffectDefinition": {
      "type": "object",
      "description": "Definición de las propiedades de un MetaItem.",
      "properties": {
        "name": {
          "type": "string",
          "description": "El nombre único del item. (Requerido)"
        },
        "damage": {
          "type": "string",
          "description": "Expresión de dado para el dado (ej: '1d6+2')."
        },
        "damageType": {
          "type": "string",
          "description": "El tipo de dado del item (Enum DamageType).",
          "enum": [ "None", "Physical", "Acid", "Explosive", "Fire", "Ice", "Lightning", "Poison" ]
        },
        "hp": {
          "type": "string",
          "description": "Expresión de dado para los puntos de vida que otorga (ej: '1d4')."
        },
        "impactWord": {
          "type": "string",
          "description": "La palabra de impacto asociada (Enum ImpactWordName).",
          "enum": [ "None", "AghGreen", "AghRed", "BoomPurple", "BoomRed", "BangBlue", "BangRed", "CrackBlue", "CrackYellow", "CuackPurple", "CuackYellow", "Kapow", "KapowStrong", "OuchBlue", "OuchGreen", "PlopRed", "PlopYellow", "SlapBlue", "SlapRed", "Zap" ]
        },
        "luckBonus": {
          "type": "number",
          "default": 0,
          "minimum": 0,
          "maximum": 1,
          "description": "Bonus de suerte."
        },
        "sound": {
          "type": "string",
          "description": "Nombre del sonido principal al usar el item (se busca en Sound.FindNotNull)."
        }
      },
      "required": [
        "name"
      ],
      "additionalProperties": false
    }
  }
}