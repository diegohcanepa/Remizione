{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "EffectDescriptor.schema.json",
  "title": "Effect Descriptor",
  "type": "object",
  "properties": {
    "effectType": {
      "$ref": "enums.schema.json#/$defs/EffectType"
    },
    "amount": {
      "type": "string",
      "description": "Cantidad o expresión de dados (ej: '1d6', '5')."
    },
    "chance": {
      "type": "number", 
      "format": "float",
      "default": 1.0,
      "maximum": 1.0,
      "minimum": 0,
      "description": "Probabilidad de que el efecto se aplique."
    },    
    "comicText": {
      "$ref": "enums.schema.json#/$defs/ComicTextKind"
    },
    "context": {
      "$ref": "enums.schema.json#/$defs/EffectContext"
    },
    "damageType": {
      "$ref": "enums.schema.json#/$defs/DamageType"
    },
    "knockback": {
      "$ref": "enums.schema.json#/$defs/KnockbackIntensity"
    },
    "target": {
      "$ref": "enums.schema.json#/$defs/EffectTarget"
    },
    "sound": {
      "type": "string",
      "description": "Nombre del archivo de sonido a reproducir."
    },
    "statusType": {
      "$ref": "enums.schema.json#/$defs/StatusType"
    }
  },
  "required": [ "effectType", "context" ],
  "additionalProperties": false
}