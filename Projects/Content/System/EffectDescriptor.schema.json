{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "EffectDescriptor.schema.json",
  "title": "Effect Descriptor",
  "type": "object",
  "properties": {
    "effectType": {
      "type": "string",
      "description": "El tipo de acción a ejecutar.",
      "enum": [ "None", "Damage", "Death", "Heal", "Luck", "AddCondition", "RemoveCondition" ] 
    },
    "amount": {
      "type": "string",
      "description": "Cantidad o expresión de dados (ej: '1d6', '5')."
    },
    "chance": {
      "type": "number",
      "format": "float",
      "default": 1.0,
      "maximum": 1.0,
      "minimum": 0,
      "description": "Probabilidad de que el efecto se aplique."
    },    
    "context": {
      "type": "string",
      "description": "Contexto en donde es aplicable el efecto.",
      "enum": [ "Contact", "Attack", "Update", "Use" ],
      "default": "OnContact"
    },
    "damageType": {
      "type": "string",
      "description": "Si es daño, qué tipo es.",
      "enum": [ "None", "Physical", "Acid", "Explosive", "Fire", "Ice", "Lightning", "Poison" ],
      "default": "None"
    },
    "factor": {
      "type": "number",
      "format": "float",
      "default": 1.0,
      "minimum": 0,
      "description": "Multiplier."
    },      
    "impactWord": {
      "type": "string",
      "description": "Nombre de la Onomatopella a mostrar.",
      "enum": [ "None", "AghGreen", "AghRed", "BoomPurple", "BoomRed", "BangBlue", "BangRed", "CrackBlue", "CrackYellow", "CuackPurple", "CuackYellow", "Kapow", "KapowStrong", "OuchBlue", "OuchGreen", "PlopRed", "PlopYellow", "SlapBlue", "SlapRed", "Zap" ],
      "default": "None"
    },
    "knockback": {
      "type": "string",
      "description": "Fuerza del knockback."
    },
    "target": {
      "type": "string",
      "description": "A quién se aplica el efecto.",
      "enum": [ "Self", "Target" ],
      "default": "Target"
    },
    "sound": {
      "type": "string",
      "description": "Nombre del archivo de sonido a reproducir."
    }
  },
  "required": [ "effectType", "context" ]
}