{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "EffectDescriptor.schema.json",
  "title": "Effect Descriptor",
  "type": "object",
  "properties": {
    "effectType": {
      "type": "string",
      "description": "El tipo de acción a ejecutar.",
      "enum": [ "None", "BronzeKey", "Coin", "CoinLoss", "ComicText", "Damage", "Death", "EnergyGain", "EnergyLoss", "HPGain", "HPLoss", "StaminaGain", "StaminaLoss", "MaxEnergyGain", "MaxEnergyLoss", "MaxHPGain", "MaxHPLoss", "MaxStaminaGain", "MaxStaminaLoss", "GoldenKey", "Status" ] ,
      "default": "None"
    },
    "amount": {
      "type": "string",
      "description": "Cantidad o expresión de dados (ej: '1d6', '5')."
    },
    "chance": {
      "type": "number", 
      "format": "float",
      "default": 1.0,
      "maximum": 1.0,
      "minimum": 0,
      "description": "Probabilidad de que el efecto se aplique."
    },    
    "comicText": {
      "type": "string",
      "enum": [ "None", "AghGreen", "AghRed", "AghPurple", "BoomPurple", "BoomRed", "BangBlue", "BangRed", "CrackBlue", "CrackYellow", "CuackPurple", "CuackYellow", "Kapow", "KapowStrong", "OuchBlue", "OuchGreen", "PlopRed", "PlopYellow", "SlapBlue", "SlapRed", "Zap" ],
      "default": "None"
    },
    "context": {
      "type": "string",
      "description": "Contexto en donde es aplicable el efecto.",
      "enum": [ "Collect", "Contact", "Attack", "Update", "RemainsContact", "Use", "ProjectileHit", "RunModifier", "Status", "ApplyStatus" ],
      "default": "Contact"
    },
    "damageType": {
      "type": "string",
      "description": "Si es daño, qué tipo es.",
      "enum": [ "None", "Physical", "Acid", "Curse", "Explosive", "Fire", "Ice", "Lightning", "Poison" ],
      "default": "None"
    },
    "knockback": {
      "type": "string",
      "description": "intensidad del knockback.",
      "enum": [ "None", "Low", "Medium", "High" ],
      "default": "Low"
    },
    "target": {
      "type": "string",
      "description": "A quién se aplica el efecto.",
      "enum": [ "Self", "Target" ],
      "default": "Target"
    },
    "sound": {
      "type": "string",
      "description": "Nombre del archivo de sonido a reproducir."
    },
    "statusType": {
      "type": "string",
      "enum": [ "Poison" ],
      "default": "None"
    }
  },
  "required": [ "effectType", "context" ],
  "additionalProperties": false
}