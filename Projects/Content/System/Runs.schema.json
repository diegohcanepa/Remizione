{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Runs",
  "type": "object",
  "properties": {
    "data": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Run"
      }
    }
  },
  "required": [
    "data"
  ],
  "additionalProperties": false,
  "$defs": {
    "Run": {
      "type": "object",
      "properties": {
        "runIndex": {
          "type": "integer"
        },
        "floors": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Floor"
          }
        }
      },
      "required": [
        "runIndex",
        "floors"
      ],
      "additionalProperties": false
    },
    "Floor": {
      "type": "object",
      "properties": {
        "allowedPuzzles": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "BronzeKey",
              "GateLever"
            ]
          }
        },
        "roomCount": {
          "type": "integer",
          "minimum": 5
        },
        "theme": {
          "type": "string",
          "enum": [
            "Castle"
          ]
        }
      },
      "required": [
        "rooms",
        "theme"
      ],
      "additionalProperties": false
    }
  }
}