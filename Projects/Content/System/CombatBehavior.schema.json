{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "CombatBehavior.schema.json",
  "title": "Combat Behavior Data File",
  "type": "object",
  "properties": {
    "data": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/CombatBehavior"
      }
    }
  },
  "required": [
    "data"
  ],
  "$defs": {
    "CombatBehavior": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
         },
        "archetype": {
          "$ref": "enums.schema.json#/$defs/CombatArchetypeName"
        },
        "intents": {
          "type": "array",
           "items": {
            "$ref": "./CombatIntent.schema.json"
          },
          "minItems": 0
        },
        "turnInterval": {
          "type": "integer",
          "default": 2,
          "minimum": 1
        }
      },
      "required": [
        "name",
        "archetype",
        "intents"
      ],
      "unevaluatedProperties": false
    }
  }
}