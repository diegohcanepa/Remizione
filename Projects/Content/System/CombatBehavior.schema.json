{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "CombatBehavior.schema.json",
  "title": "Combat Behavior Data File",
  "type": "object",
  "properties": {
    "data": {
      "type": "array",
      "description": "Lista de configuraciones de comportamiento de combate.",
      "items": {
        "$ref": "#/$defs/CombatBehavior"
      }
    }
  },
  "required": [
    "data"
  ],
  "$defs": {
    "CombatBehavior": {
      "type": "object",
      "description": "Define la personalidad y el pool de intenciones de un actor.",
      "properties": {
        "name": {
          "type": "string",
          "description": "El nombre del comportamiento. Debe coincidir con el Name del Actor para el linkeo."
        },
        "archetype": {
          "type": "string",
          "enum": [
            "Lurker",
            "Stalker",
            "Tactical",
            "Berserk",
            "Coward"
          ],
          "default": "Lurker"
        },
        "intents": {
          "type": "array",
          "description": "Lista de intenciones (ataques, estados, etc.) de este bicho.",
          "items": {
            "$ref": "./CombatIntent.schema.json"
          },
          "minItems": 1
        }
      },
      "required": [
        "name",
        "archetype",
        "intents"
      ],
      "unevaluatedProperties": false
    }
  }
}