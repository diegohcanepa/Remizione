{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "Thing.schema.json",
  "allOf": [
    {
      "$ref": "./Entity.schema.json"
    },
    {
      "type": "object",
      "properties": {
        "baseDropChance": {
          "type": "number",
          "default": 0.5,
          "minimum": 0.0,
          "maximum": 1.0
        },
        "faction": {
          "$ref": "enums.schema.json#/$defs/Faction"
        },
        "graceReward": {
          "type": "integer"
        },
        "lootPool": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "item",
              "weight"
            ],
            "additionalProperties": false,
            "properties": {
              "item": {
                "type": "string"
              },
              "weight": {
                "type": "number",
                "minimum": 1
              }
            }
          }
        },
        "maxPerRoom": {
          "type": "integer",
          "default": -1
        },
        "roomTheme": {
          "$ref": "enums.schema.json#/$defs/RoomTheme"
        },
        "spawnScope": {
          "$ref": "enums.schema.json#/$defs/SpawnScope"
        },
        "targeRoomCategory": {
          "$ref": "enums.schema.json#/$defs/RoomCategory"
        },
        "xp": {
          "type": "integer",
          "default": 0,
          "minimum": 1
        }
      }
    }
  ]
}