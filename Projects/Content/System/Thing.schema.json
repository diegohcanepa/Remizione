{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "Thing.schema.json",
  "allOf": [
    {
      "$ref": "./Entity.schema.json"
    },
    {
      "type": "object",
      "properties": {
        "dropCoinChanceBonus": {
          "type": "number",
          "default": 0,
          "minimum": 0.0,
          "maximum": 1.0
        },
        "dropSackChanceBonus": {
          "type": "number",
          "default": 0,
          "minimum": 0.0,
          "maximum": 1.0
        },
        "dropMode": {
          "$ref": "enums.schema.json#/$defs/LootDropMode"
        },
        "dropTrigger": {
          "$ref": "enums.schema.json#/$defs/LootDropTrigger"
        },
        "faction": {
          "$ref": "enums.schema.json#/$defs/Faction"
        },
        "maxPerRoom": {
          "type": "integer",
          "default": -1
        },
        "requiredRoomCategory": {
          "type": "string"
        },
        "roomTheme": {
          "$ref": "enums.schema.json#/$defs/RoomTheme"
        },
        "xp": {
          "type": "integer",
          "default": 0,
          "minimum": 1
        }
      }
    }
  ]
}