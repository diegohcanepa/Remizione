{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "Thing.schema.json",
  "allOf": [
    {
      "$ref": "./Entity.schema.json"
    },
    {
      "type": "object",
      "properties": {
        "dropChanceMultiplier": {
          "type": "number",
          "default": 1.0,
          "minimum": 0.0,
          "maximum": 1.0
        },        
        "dropMode": {
          "type": "string",
          "enum": [
            "Standard",
            "CoinsOnly",
            "SackOnly",
            "Custom",
            "None"
          ],
          "default": "Standard"
        },
        "requiresDeadEnd": {
          "type": "boolean"
        },
        "maxPerRoom": {
          "type": "integer",
          "default": -1
        },
        "minProgress": {
          "type": "number",
          "default": 0.0,
          "minimum": 0.0,
          "maximum": 1.0
        }
      }
    }
  ]
}