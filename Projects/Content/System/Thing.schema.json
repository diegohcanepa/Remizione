{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "Thing.schema.json",
  "allOf": [
    {
      "$ref": "./Entity.schema.json"
    },
    {
      "type": "object",
      "properties": {
        "dropCoinChanceBonus": {
          "type": "number",
          "default": 0,
          "minimum": 0.0,
          "maximum": 1.0
        },
        "dropSackChanceBonus": {
          "type": "number",
          "default": 0,
          "minimum": 0.0,
          "maximum": 1.0
        },
        "dropMode": {
          "type": "string",
          "enum": [
            "Standard",
            "CoinsOnly",
            "SackOnly",
            "Custom",
            "None"
          ],
          "default": "Standard"
        },
        "dropTrigger": {
          "type": "string",
          "enum": [
            "OnDeath",
            "OnImpact"
          ],
          "default": "OnDeath"
        },
        "faction": {
          "type": "string",
          "enum": [
            "Good",
            "Evil"
          ]
        },
        "isUnique": {
          "type": "boolean",
          "default": false
        },
        "maxPerRoom": {
          "type": "integer",
          "default": -1
        },
        "roomTheme": {
          "type": "string",
          "enum": [
            "Castle"
          ]
        },
        "xp": {
          "type": "integer",
          "default": 0,
          "minimum": 1
        }
      }
    }
  ]
}