{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "Thing.schema.json",
  "allOf": [
    {
      "$ref": "./Entity.schema.json"
    },
    {
      "type": "object",
      "properties": {
        "requiresDeadEnd": {
          "type": "boolean"
        },
        "maxPerRoom": {
          "type": "integer",
          "default": -1
        },
        "maxSpawnAmount": {
          "type": "integer",
          "default": 1,
          "minimum": 1
        },
        "minSpawnAmount": {
          "type": "integer",
          "default": 1,
          "minimum": 1
        },
        "placements": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "Floor",
              "WallFrontBase",
              "WallFrontHang",
              "WallLeftBase",
              "WallLeftHang",
              "WallRightBase",
              "WallRightHang",
              "Ceiling",
              "WalkArea"
            ]
          }
        }
      }
    }
  ]
}