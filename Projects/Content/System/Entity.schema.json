{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "Entity.schema.json",
  "title": "Entity definition",
  "type": "object",
  "allOf": [
    {
      "$ref": "Definition.schema.json"
    },
    {
      "type": "object",
      "properties": {
        "difficulty": {
          "type": "string",
          "description": "Nivel de dificultad.",
          "enum": [
            "Easy",
            "Normal",
            "Hard"
          ]
        },
        "maxPerRun": {
          "type": "integer",
          "default": 0,
          "minimum": 0,
          "description": "Número máximo de veces que este elemento puede aparecer por 'run'."
        },
        "minFloor": {
          "type": "integer",
          "default": 0,
          "minimum": 0,
          "description": "Mínimo de piso requerido para que esta configuración sea elegible."
        },
        "pools": {
          "type": "string",
          "description": "Lista de etiquetas a las que pertenece esta configuración (Tags)."
        },
        "preferredLootCategory": {
          "type": "string",
          "description": "Categoría preferida para el loot.",
          "enum": [
            "Explosive",
            "Food",
            "Luck",
            "Medicine",
            "Misc"
          ]
        },
        "preferredLootRealm": {
          "type": "string",
          "description": "Reino preferido para el loot.",
          "enum": [
            "Earthly",
            "Infernal",
            "Celestial"
          ]
        },
        "tags": {
          "type": "string",
          "description": "Lista de etiquetas usadas para aplicar restricciones de 'scope' (Tags)."
        }
      },
      "additionalProperties": false
    }
  ]
}