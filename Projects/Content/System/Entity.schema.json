{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "Entity.schema.json",
  "allOf": [
    {
      "$ref": "Definition.schema.json"
    },
    {
      "type": "object",
      "properties": {
        "difficulty": {
          "$ref": "enums.schema.json#/$defs/Difficulty"
        },
        "maxPerRun": {
          "type": "integer",
          "default": -1
        },
        "minFloor": {
          "type": "integer",
          "default": 0,
          "minimum": 0
        },
        "pools": {
          "type": "string"
        },
        "preferredLootCategory": {
          "$ref": "enums.schema.json#/$defs/ItemCategory"
        },
        "preferredLootRealm": {
          "$ref": "enums.schema.json#/$defs/Realm"
        },
        "qualityBoost": {
          "type": "integer",
          "minimum": 0
        },
        "tags": {
          "type": "string"
        }
      },
      "required": ["difficulty"]
    }
  ]
}