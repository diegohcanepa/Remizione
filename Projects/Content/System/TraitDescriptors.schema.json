{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "data": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/TraitDescriptor"
      }
    }
  },
  "required": [
    "data"
  ],
  "additionalProperties": false,
  "$defs": {
    "TraitDescriptor": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "value": {
          "type": "number"
        }
      },
      "required": [
        "name",
        "value"
      ],
      "additionalProperties": false
    }
  }
}