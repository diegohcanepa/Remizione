{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "Actor.schema.json",
  "type": "object",
  "properties": {
    "data": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Actor"
      }
    }
  },
  "required": ["data"],
  "$defs": {
    "Actor": {
      "allOf": [
        { "$ref": "./Thing.schema.json" },
        {
          "type": "object",
          "properties": {
            "faction": {
              "type": "string",
              "default": "Evil",
              "enum": ["Good", "Evil"]
            },
            "role": {
              "type": "string",
              "default": "Guard",
              "enum": ["Ambient", "Guard", "Interactive"]
            }
          },
          "required": [
            "role"
          ]          
        }
      ],
      "unevaluatedProperties": false
    }
  }
}