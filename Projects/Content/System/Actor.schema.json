{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "Actor.schema.json",
  "type": "object",
  "properties": {
    "data": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Actor"
      }
    }
  },
  "required": [
    "data"
  ],
  "$defs": {
    "Actor": {
      "allOf": [
        {
          "$ref": "./Thing.schema.json"
        },
        {
          "type": "object",
          "properties": {
            "minPackSize": {
              "type": "integer",
              "default": 1,
              "minimum": 1
            },
            "maxPackSize": {
              "type": "integer",
              "default": 1,
              "minimum": 1
            },
            "rank": {
              "$ref": "enums.schema.json#/$defs/ActorRank"
            }
          }
        }
      ],
      "unevaluatedProperties": false
    }
  }
}