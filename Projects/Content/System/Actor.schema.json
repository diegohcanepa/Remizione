{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "Actor.schema.json",
  "title": "Actor Data File",
  "type": "object",
  "properties": {
    "data": {
      "type": "array",
      "description": "Lista de definiciones de Actores.",
      "items": {
        "$ref": "#/$defs/Actor"
      }
    }
  },
  "required": [
    "data"
  ],
  "$defs": {
    "Actor": {
      "description": "Un Actor hereda todo de Thing pero agrega propiedades de combate.",
      "allOf": [
        {
          "$ref": "./Thing.schema.json"
        },
        {
          "type": "object",
          "properties": {
            "attackCooldown": {
              "type": "integer",
              "description": "Tiempo de espera entre ataques (en ticks/frames).",
              "minimum": 0,
              "default": 0
            }
          }
        }
      ],
      "unevaluatedProperties": false
    }
  }
}