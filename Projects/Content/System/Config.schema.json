{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "Config.schema.json",
  "title": "Config base",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Nombre único de la configuración. (Requerido)"
    },
    "difficulty": {
      "type": "string",
      "description": "Nivel de dificultad.",
      "enum": [
        "Easy",
        "Normal",
        "Hard"
      ]
    },
    "maxPerRun": {
      "type": "integer",
      "default": 0,
      "minimum": 0,
      "description": "Número máximo de veces que este elemento puede aparecer por 'run'."
    },
    "pools": {
      "type": "string",
      "description": "Lista de etiquetas a las que pertenece esta configuración (Tags)."
    },
    "preferredLootCategory": {
      "type": "string",
      "description": "Categoría preferida para el loot.",
      "enum": [
        "LeftHand",
        "RightHand",
        "Consumable",
        "Gadget",
        "KeyItem"
      ]
    },
    "preferredLootRealm": {
      "type": "string",
      "description": "Reino preferido para el loot.",
      "enum": [
        "Earthly",
        "Infernal",
        "Celestial"
      ]
    },
    "requiredRuns": {
      "type": "integer",
      "default": 0,
      "minimum": 0,
      "description": "Número total de 'runs' jugadas requeridas para que esta configuración sea elegible."
    },
    "tags": {
      "type": "string",
      "description": "Lista de etiquetas usadas para aplicar restricciones de 'scope' (Tags)."
    },
    "weight": {
      "type": "number",
      "format": "float",
      "default": 1.0,
      "minimum": 0,
      "description": "Peso o probabilidad asociada a esta configuración. Por defecto es 1."
    }
  },
  "required": [
    "name"
  ]
}