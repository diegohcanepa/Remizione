{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "CombatIntent.schema.json",
  "title": "Combat Intent",
  "description": "Define una acción de combate. Hereda name, effects y spawnWeight de Definition.",
  "type": "object",
  "allOf": [
    {
      "$ref": "./Definition.schema.json"
    },
    {
      "type": "object",
      "properties": {
        "category": {
          "type": "string",
          "description": "Tipo de intensidades del ataque.",
          "enum": [
            "Basic",
            "Special"
          ]
        },
        "thrownObject": {
          "type": "string",
          "description": "Tipo de object arrojable.",
          "enum": [
            "None",
            "Bible"
          ]
        },
        "sound": {
          "type": "string",
          "description": "Nombre del archivo de sonido a reproducir."
        }
      }
    }
  ],
  "unevaluatedProperties": false
}