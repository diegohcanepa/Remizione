{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "CombatIntent.schema.json",
  "title": "Combat Intent",
  "description": "Define una acción de combate. Hereda name, effects y spawnWeight de Definition.",
  "type": "object",
  "allOf": [
    {
      "$ref": "./Definition.schema.json"
    },
    {
      "type": "object",
      "properties": {
        "actionKind": {
          "$ref": "enums.schema.json#/$defs/ActionKind"
        },
        "animationName": {
          "type": "string"
        },
        "areaOfEffect": {
          "type": "integer",
          "default": 0
        },
        "category": {
          "type": "string",
          "description": "Tipo de intensidades del ataque.",
          "enum": [
            "Basic",
            "Special",
            "Contact"
          ]
        },
        "energyCost": {
          "type": "integer"
        },
        "isCharge": {
          "type": "boolean"
        },
        "minRange": {
          "type": "integer"
        },
        "missChance": {
          "type": "number",
          "default": 0,
          "minimum": 0,
          "maximum": 1
        },
        "maxRange": {
          "type": "integer"
        },
        "soundStart": {
          "type": "string",
          "description": "Nombre del archivo de sonido a reproducir cuando comienza la accion."
        },
        "soundTrigger": {
          "type": "string",
          "description": "Nombre del archivo de sonido a reproducir en el trigger de la accion."
        },
        "telegraphAnimationName": {
          "type": "string"
        },
        "telegraphKind": {
          "$ref": "enums.schema.json#/$defs/AttackTelegraphKind"
        }
      },
      "required": [
        "actionKind"
      ]
    }
  ],
  "unevaluatedProperties": false
}