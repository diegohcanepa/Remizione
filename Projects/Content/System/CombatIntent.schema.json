{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "CombatIntent.schema.json",
  "title": "Combat Intent",
  "description": "Define una acción de combate. Hereda name, effects y spawnWeight de Definition.",
  "type": "object",
  "allOf": [
    {
      "$ref": "./Definition.schema.json"
    }
  ],
  "properties": {
    "category": {
      "type": "string",
      "description": "Tipo de intensisas del ataque.",
      "enum": [
        "Basic",
        "Special"
      ]
    }
  },
  "required": [
    "category"
  ]
}