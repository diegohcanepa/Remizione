{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "Card.schema.json",
  "title": "Card Definition",
  "type": "object",
  "properties": {
    "data": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Card"
      }
    }
  },
  "required": [
    "data"
  ],
  "$defs": {
    "Card": {
      "description": "Definicion de las propiedades de una carta.",
      "allOf": [
        {
          "$ref": "./Definition.schema.json"
        },
        {
          "type": "object",
          "properties": {
            "action": {
              "type": "string",
              "enum": [
                "Damage",
                "Shield",
                "Heal",
                "Escape"
              ]
            },
            "category": {
              "type": "string",
              "enum": [
                "Attack",
                "Defense",
                "Healing",
                "Prayer",
                "Status"
              ]
            }
          }
        }
      ]
    }
  }
}