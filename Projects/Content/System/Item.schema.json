{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "Item.schema.json",
  "title": "Item Definition",
  "type": "object",
  "properties": {
    "data": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Item"
      }
    }
  },
  "required": [
    "data"
  ],
  "$defs": {
    "Item": {
      "description": "Definición de las propiedades de un Item.",
      "allOf": [
        {
          "$ref": "./Definition.schema.json"
        },
        {
          "type": "object",
          "properties": {
            "category": {
              "type": "string",
              "enum": [
                "Explosive",
                "Food",
                "Luck",
                "Medicine",
                "Misc"
              ]
            },
            "consumptionInterval": {
              "type": "integer",
              "minimum": 0
            },
            "consumptionType": {
              "type": "string",
              "enum": [
                "None",
                "Consumable",
                "Durability"
              ]
            },
            "effects": {
              "type": "array",
              "description": "Lista de efectos que provoca este item.",
              "items": {
                "$ref": "./EffectDescriptor.schema.json"
              }
            },
            "isStackable": {
              "type": "boolean"
            },
            "pickupSound": {
              "type": "string"
            },
            "quality": {
              "type": "integer"
            },
            "range": {
              "type": "integer"
            },
            "realm": {
              "type": "string",
              "enum": [
                "Earthly",
                "Infernal",
                "Celestial"
              ]
            },
            "skillChance": {
              "type": "integer"
            }
          }
        }
      ]
    }
  }
}