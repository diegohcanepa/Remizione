{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "Item.schema.json",
  "title": "Item Definition",
  "type": "object",
  "properties": {
    "data": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Item"
      }
    }
  },
  "required": [
    "data"
  ],
  "$defs": {
    "Item": {
      "description": "Definición de las propiedades de un Item.",
      "allOf": [
        {
          "$ref": "./Definition.schema.json"
        },
        {
          "type": "object",
          "properties": {
            "category": {
              "type": "string",
              "enum": [
                "Access",
                "Explosive",
                "Food",
                "Luck",
                "Medicine",
                "Money",
                "Misc"
              ]
            },
            "areaRange": {
              "type": "integer",
              "default": 0
            },
            "executionDelay": {
              "type": "integer",
              "minimum": 0
            },
            "isDepletable": {
              "type": "boolean"
            },
            "isStackable": {
              "type": "boolean"
            },
            "gooCost": {
              "type": "integer"
            },
            "initialAmount": {
              "type": "integer",
              "default": 1
            },
            "lightColor": {
              "type": "string"
            },
            "lightModifier": {
              "type": "number",
              "default": 0.0,
              "minimum": 0.0
            },
            "luckModifier": {
              "type": "number",
              "default": 0.0
            },
            "pickupSound": {
              "type": "string",
              "description": "Nombre del archivo de sonido a reproducir cuando se colecta."
            },
            "skillChance": {
              "type": "integer"
            },
            "sound": {
              "type": "string",
              "description": "Nombre del archivo de sonido a reproducir."
            },
            "usageScope": {
              "type": "string",
              "enum": [
                "Close",
                "FreeRange",
                "LineOfFire",
                "Self"
              ]
            }
          },
          "required": [
            "usageScope"
          ]          
        }
      ],
      "unevaluatedProperties": false
    }
  }
}