{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "Item.schema.json",
  "title": "Item Definition",
  "type": "object",
  "properties": {
    "data": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Item"
      }
    }
  },
  "required": [
    "data"
  ],
  "$defs": {
    "Item": {
      "description": "Definición de las propiedades de un Item.",
      "allOf": [
        {
          "$ref": "./Definition.schema.json"
        },
        {
          "type": "object",
          "properties": {
            "actionKind": {
              "type": "string",
              "enum": [
                "InPlace",
                "Projectile",
                "Proximity",
                "Script",
                "Self"
              ],
              "default": "Script"
            },
            "animationName": {
              "type": "string"
            },
            "category": {
              "type": "string",
              "enum": [
                "Access",
                "Explosive",
                "Food",
                "Luck",
                "Medicine",
                "Money",
                "Misc",
                "Pills"
              ]
            },
            "areaOfEffect": {
              "type": "integer",
              "default": 0
            },
            "behavior": {
              "type": "string",
              "enum": [
                "Common",
                "Currency",
                "Skill",
                "StatModifier"
              ],
              "default": "Common"
            },
            "consumeVerb": {
              "type": "string",
              "enum": [
                "None",
                "Consumed",
                "Obtained",
                "Found",
                "Lost",
                "Requires",
                "Used"
              ],
              "default": "Script"
            },            
            "deselectOnUse": {
              "type": "boolean",
              "default": false
            },
            "isDepletable": {
              "type": "boolean"
            },
            "isStackable": {
              "type": "boolean"
            },
            "energyCost": {
              "type": "integer"
            },
            "initialAmount": {
              "type": "integer",
              "default": 1,
              "maximum": 5,
              "minimum": 1
            },
            "inPlaceEffectType": {
              "type": "string",
              "enum": [
                "None",
                "Lightning"
              ],
              "default": "Lightning"
            },
            "lightColor": {
              "type": "string"
            },
            "lightModifier": {
              "type": "number",
              "default": 0.0,
              "minimum": 0.0
            },
            "luckModifier": {
              "type": "number",
              "default": 0.0
            },
            "pickupSound": {
              "type": "string",
              "description": "Nombre del archivo de sonido a reproducir cuando se colecta."
            },
            "projectile": {
              "$ref": "Projectile.schema.json",
              "description": "Referencia al comportamiento y descriptor del proyectil que este ítem dispara o genera."
            },            
            "skillChance": {
              "type": "integer"
            },
            "soundStart": {
              "type": "string",
              "description": "Nombre del archivo de sonido a reproducir cuando comienza la accion."
            },
            "soundTrigger": {
              "type": "string",
              "description": "Nombre del archivo de sonido a reproducir en el trigger de la accion."
            }
          },
          "required": [
            "actionKind"
          ]          
        }
      ],
      "unevaluatedProperties": false
    }
  }
}