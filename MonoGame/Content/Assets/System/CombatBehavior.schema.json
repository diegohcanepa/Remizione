{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "CombatBehavior.schema.json",
  "title": "Combat Behavior Data File",
  "type": "object",
  "properties": {
    "data": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/CombatBehavior"
      }
    }
  },
  "required": [
    "data"
  ],
  "$defs": {
    "CombatBehavior": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "archetype": {
          "type": "object",
          "properties": {
            "awarenessRange": {
              "type": "number",
              "minimum": 0
            },
            "loseSightRange": {
              "type": "number",
              "minimum": 0
            },
            "cooldownDuration": {
              "type": "number",
              "minimum": 0
            },
            "exposedPauseDuration": {
              "type": "number",
              "minimum": 0
            },
            "maxStepPerTurn": {
              "type": "number",
              "minimum": 0
            },
            "fallbackMovement": {
              "$ref": "enums.schema.json#/$defs/FallbackMovementKind"
            }
          },
          "required": [
            "awarenessRange",
            "loseSightRange",
            "cooldownDuration",
            "exposedPauseDuration",
            "maxStepPerTurn",
            "fallbackMovement"
          ],
          "additionalProperties": false
        },
        "intents": {
          "type": "array",
          "items": {
            "$ref": "./CombatIntent.schema.json"
          },
          "minItems": 0
        },
        "leashRadius": {
          "type": "integer"
        }
      },
      "required": [
        "name",
        "intents"
      ],
      "unevaluatedProperties": false
    }
  }
}