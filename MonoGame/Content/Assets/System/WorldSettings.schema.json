{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "WorldSettings.schema.json",
  "title": "World Settings",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },    
    "bonfireDuration": {
      "type": "integer"
    },
    "darkCycleTransitionDuration": {
      "type": "integer"
    },
    "darkCycleDuration": {
      "type": "integer"
    },
    "lightCycleDuration": {
      "type": "integer"
    },
    "lightCycleTransitionDuration": {
      "type": "integer"
    },
    "sulfurStoneDuration": {
      "type": "integer"
    }
  },
  "required": [
    "bonfireDuration",
    "darkCycleDuration",
    "lightCycleDuration"
  ],
  "unevaluatedProperties": false
}